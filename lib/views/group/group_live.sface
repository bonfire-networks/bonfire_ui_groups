<main
  data-id={if @type == :topic, do: "topic", else: "group"}
  data-group-id={e(@category, :id, "")}
>
  {!-- `view_mode` comes from `Bonfire.Classify.LiveHandler.mounted/3`, which picks it from the fetch that succeeded: `:full` for a visitor holding `:read`, `:preview` for one holding only `:see`, `:archived` for someone who could restore it. --}
  {!-- Group previews keep the hero, but replace the timeline with an access notice. --}
  {#case e(assigns, :view_mode, :full)}
    {#match :preview when @type == :topic}
      <StatelessComponent
        module={maybe_component(Bonfire.UI.Topics.TopicAccessGateLive, @__context__)}
        category={@category}
        permalink={@permalink}
        group_return_to={@group_return_to}
        parent={e(assigns, :topic_gate, :parent, nil)}
        parent_member={e(assigns, :topic_gate, :parent_member, false)}
        membership={e(assigns, :topic_gate, :membership, nil)}
      />
    {#match :archived}
      <div
        class="mb-4 flex flex-col gap-3 rounded-box border border-divider bg-base-200 p-4 sm:flex-row sm:items-center"
        role="status"
      >
        <div class="flex flex-1 items-start gap-3">
          <div class="grid size-10 shrink-0 place-items-center rounded-box bg-fill">
            <#Icon iconify="ph:archive-duotone" class="size-5 text-muted" />
          </div>
          <div class="flex-1">
            <div class="font-medium text-base-content">{l("This group is archived")}</div>
            <p class="mt-0.5 text-sm text-muted">
              {l("It's hidden from members and listings. Restore it to bring it back online.")}
            </p>
          </div>
        </div>
        {#if Bonfire.Classify.ensure_update_allowed(current_user(@__context__), @category)}
          <button
            type="button"
            id="group_unarchive_button"
            :on-click="Bonfire.Classify:unarchive"
            data-confirm={l("Restore this group and bring it back online?")}
            class="btn btn-primary btn-sm shrink-0 gap-2 normal-case sm:self-center"
          >
            <#Icon iconify="ph:arrow-counter-clockwise" class="size-4" />
            {l("Unarchive")}
          </button>
        {/if}
      </div>
      <div
        data-role="category_preview"
        class="mx-auto flex w-full max-w-2xl flex-col gap-4 p-4 pointer-events-none opacity-70 grayscale-40"
        aria-label={l("Preview of the archived group")}
      >
        {!-- this page renders groups AND their topics, so the card comes from the `:object_preview` registry keyed on the category's own type --}
        <StatelessComponent
          module={maybe_component(
            Config.get([:ui, :object_preview, @type], Bonfire.Classify.Web.Preview.CategoryLive),
            @__context__
          )}
          object={@category}
          object_boundary={@object_boundary}
          permalink={@permalink}
          showing_within={:preview}
        />
      </div>
    {#match _}
      <StatelessComponent
        module={cond do
          e(assigns, :view_mode, :full) == :preview ->
            Bonfire.UI.Groups.AccessGateLive

          @type == :topic ->
            Config.get([:ui, :topic, :sections], [])[tab(@selected_tab)] ||
              Bonfire.UI.Social.ProfileTimelineLive

          true ->
            tab_component(@selected_tab) || tab_component(@tab_id) ||
              Bonfire.UI.Social.ProfileTimelineLive
        end}
        user={@category}
        {...assigns}
        custom_actions={Bonfire.UI.Social.Activity.DiscussionPreviewActionsLive}
      >
        <:header>
          {!-- `frame_group`, `members`, `subcategories` and the slugs are assigned by `Bonfire.Classify.LiveHandler.mounted/4` --}
          {!-- in a group, the header and composer read as one block over a single rule; drawn here because either may be absent (visitors get no composer) --}
          <div
            data-role="group-header-block"
            class={
              "border-b-(length:--divider-width) border-divider":
                @frame_group && not group_settings?(@type, @selected_tab)
            }
          >
            {#if not (group_settings?(@type, @selected_tab) and @view_mode == :full)}
              {!-- a group, or a topic inside one: the group's header and topic chips, with the topic's chip selected --}
              <StatelessComponent
                :if={@frame_group}
                module={Config.get(
                  [:ui, :group, :hero_component],
                  Bonfire.UI.Groups.GroupHeroLive
                )}
                group={@frame_group}
                permalink={path(@frame_group)}
                moderators={@moderators}
                members={@members}
                my_membership={@my_group_membership}
                group_return_to={@group_return_to}
                membership_slug={@group_membership_slug}
                member_count={@group_member_count}
                pins={@group_pins}
                subcategories={@subcategories}
                selected_topic={if @type == :topic, do: @category}
                can_create_topic={@can_create_topic}
                can_edit_topic={@can_edit_topic}
              />
              {!-- inside a group the topic's chip carries its name and actions, so only a standalone topic gets its own header --}
              <StatelessComponent
                :if={@type == :topic and is_nil(@frame_group)}
                module={maybe_component(Bonfire.UI.Topics.TopicHeroLive, @__context__)}
                category={@category}
                permalink={@permalink}
                object_boundary={@object_boundary}
                boundary_preset={@boundary_preset}
                user={e(@category, :parent_category, nil)}
              />
            {/if}
            <StatelessComponent
              :if={@view_mode == :full and @can_create_in_category and not group_settings?(@type, @selected_tab)}
              module={maybe_component(Bonfire.UI.Common.InlineComposerPlaceholderLive, @__context__)}
              selected_tab={@selected_tab}
              prompt={if @type == :topic,
                do:
                  l("Start a discussion in %{name}…",
                    name: Bonfire.Classify.Web.Preview.CategoryLive.name(@category, l("topic"))
                  ),
                else: l("Start a discussion…")}
              smart_input_opts={@composer_opts}
              divider={is_nil(@frame_group)}
            />
          </div>
          {!-- the feed's own gutter (wrapper_class) lines the pins up with the posts below --}
          <StatefulComponent
            module={maybe_component(Bonfire.UI.Reactions.PinnedCarouselLive, @__context__)}
            id="group_pinned_carousel"
            scope={if @type == :topic, do: :topic, else: :group}
            scope_object={@category}
            class="border-b border-divider pt-3.5 pb-4"
            wrapper_class="w-full relative bg-transparent px-(--stream-content-padding)"
            title_class="pb-2.5"
            heading_class="text-[13px] font-medium text-base-content/58"
            hide_empty
          />
        </:header>
      </StatelessComponent>
  {/case}
</main>
