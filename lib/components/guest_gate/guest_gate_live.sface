<section>
  <#slot {@header} />
  <div class="relative mx-auto w-full max-w-2xl px-4 pb-8" data-id="profile_timeline">
    {!-- A hint of the feed the invitation stands in for. Decorative: nothing here is real content, so it is hidden from assistive tech. --}
    <div class="flex flex-col gap-3 select-none blur-sm" aria-hidden="true">
      {#for _ <- 1..3}
        <div class="flex gap-3 rounded-xl border border-secondary bg-base-100 p-4">
          <div class="size-10 shrink-0 rounded-full bg-base-content/10" />
          <div class="flex flex-1 flex-col gap-2">
            <div class="h-3 w-1/3 rounded bg-base-content/10" />
            <div class="h-3 w-full rounded bg-base-content/5" />
            <div class="h-3 w-4/5 rounded bg-base-content/5" />
          </div>
        </div>
      {/for}
    </div>

    <div
      id="group_guest_gate"
      role="region"
      aria-labelledby="group_guest_gate_title"
      class="absolute inset-0 flex items-start justify-center px-4 pt-6"
    >
      <div class="flex w-full max-w-md flex-col items-center gap-4 rounded-xl border border-secondary bg-base-100 p-6 text-center shadow-xl">
        <div class="grid size-12 place-items-center rounded-full bg-primary/10">
          <#Icon iconify="ph:lock-key-duotone" class="size-6 text-primary" />
        </div>
        <h2 id="group_guest_gate_title" class="text-lg font-semibold text-base-content">
          {l("Join %{instance} to see this content", instance: Bonfire.Application.name())}
        </h2>
        <div class="text-sm text-muted">
          {#case gated_login_message()}
            {#match nil}
              {l("Posts in %{name} are only for people with an account on %{instance}.",
                name: e(@category, :profile, :name, l("this group")),
                instance: Bonfire.Application.name()
              )}
            {#match message}
              {rich(message)}
          {/case}
        </div>
        <div class="flex w-full flex-col gap-2 sm:flex-row sm:justify-center">
          {#case external_signup_url()}
            {#match nil}
              <a href="/signup" class="btn btn-primary btn-sm normal-case">
                {l("Sign up")}
              </a>
            {#match url}
              <a href={url} target="_blank" rel="noopener" class="btn btn-primary btn-sm normal-case">
                {l("Sign up")}
              </a>
          {/case}
          <a href={login_path(@permalink)} class="btn btn-outline btn-sm normal-case">
            {l("Log in")}
          </a>
        </div>
      </div>
    </div>
  </div>
</section>
