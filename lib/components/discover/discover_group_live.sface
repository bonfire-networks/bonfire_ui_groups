<LinkLive
  to={path(@category)}
  class="hover:bg-fill-strong flex items-center w-full gap-4 px-2 py-2 rounded-selector group"
>
  <div
    class="hero relative bg-no-repeat h-[20px] w-[20px] rounded-full bg-primary bg-cover bg-center"
    style={case Media.banner_url(@category, fallback: false) do
      url when is_binary(url) -> "background-image: url('#{URI.encode(url)}');"
      _ -> ""
    end}
  />
  <span class="text-base font-normal capitalize text-base-content">{e(@category, :profile, :name, nil)}</span>
</LinkLive>

{!-- <div class="flex items-center justify-between px-1 group">
  <LinkLive
    to={path(@category)}
    class="type-overline link link-hover px-2 text-muted"
  >{e(@category, :profile, :name, nil)}</LinkLive>
 <div class="flex items-center invisible gap-1 transition-opacity transform opacity-0 group-hover:visible group-hover:opacity-100">
    <StatelessComponent module={maybe_component(Bonfire.UI.Topics.NewTopicLive)} parent={@category} />
    <LinkLive
