<.form
  for={@form}
  id="group-discovery-filters"
  action={Bonfire.UI.Groups.ExploreLive.view_path(@view)}
  method="get"
  phx-change="filter_groups"
  phx-submit="filter_groups"
  class="flex flex-col gap-4 px-4 pt-4 sm:px-6"
>
  {!-- the list of the chosen groups, or their feed --}
  <nav
    :if={modes(@view, @origin) != []}
    id="group-mode-switch"
    aria-label={l("Groups or their latest updates")}
    class="flex gap-1 self-start rounded-field bg-fill p-1"
  >
    {#for {label, to, current?} <- modes(@view, @origin)}
      <LinkPatchLive
        to={to}
        class={
          "btn btn-sm h-8 min-h-8 rounded-field border-0 px-3 font-medium shadow-none",
          "bg-base-100 text-base-content": current?,
          "btn-ghost text-muted hover:text-base-content": !current?
        }
      >{label}</LinkPatchLive>
    {/for}
  </nav>

  {!-- the view tabs; on the feed views, the origin menu sits at the end of their row, as there is no search row --}
  {!-- was `:if={current_user_id(@__context__) || feed_view?(@view)}`; the origin menu is now for signed-in users only, so a guest has nothing in this row --}
  <div
    :if={current_user_id(@__context__)}
    id="group-view-filter"
    class="flex items-center gap-6 border-b-hair border-divider"
  >
    {!-- a guest only has one view, so there is nothing to switch between --}
    <div
      :if={current_user_id(@__context__)}
      role="radiogroup"
      aria-label={l("Group view")}
      class="flex gap-6"
    >
      {#for {value, label} <- views(@view)}
        <label
          for={"group-view-#{value}"}
          class="-mb-px flex min-h-11 cursor-pointer items-center border-b-2 border-transparent text-sm font-medium text-subtle transition-colors hover:text-base-content has-[:checked]:border-base-content has-[:checked]:text-base-content has-[:focus-visible]:outline has-[:focus-visible]:outline-2"
        >
          <input
            id={"group-view-#{value}"}
            type="radio"
            name={@form[:tab].name}
            value={value}
            checked={@selected_tab == value}
            class="sr-only"
          />
          {label}
        </label>
      {/for}
    </div>

    <Bonfire.UI.Groups.GroupFilterMenusLive
      :if={feed_view?(@view)}
      menus={menus(assigns)}
      form={@form}
      class="ml-auto flex items-center gap-1 pb-1"
    />
  </div>

  {!-- was `:if={!feed_view?(@view)}`; a guest gets no search box nor filter menus, and reads this instance's groups (see `Bonfire.UI.Groups.ExploreLive`) --}
  <div
    :if={!feed_view?(@view) and current_user_id(@__context__)}
    class="flex flex-wrap items-center gap-2"
  >
    {!-- the search box searches groups, so the feed views don't show this row --}
    <label for="group-discovery-search" class="sr-only">{l("Search groups")}</label>
    <div class="input h-10 min-w-0 flex-1 basis-full gap-1 rounded-field border-0 bg-fill pl-1 transition-colors focus-within:bg-fill-strong focus-within:outline-none sm:basis-auto">
      <button
        id="group-discovery-submit"
        type="submit"
        class="grid size-9 shrink-0 place-items-center rounded-field text-subtle hover:text-base-content focus-visible:outline focus-visible:outline-2"
        aria-label={l("Search groups")}
      >
        <#Icon iconify="ph:magnifying-glass" class="size-4.5" />
      </button>
      <input
        id="group-discovery-search"
        type="search"
        name={@form[:search_term].name}
        value={@form[:search_term].value}
        placeholder={l("Search groups…")}
        phx-debounce="300"
        autocomplete="off"
        class="min-w-0 grow bg-transparent text-base sm:text-sm"
      />
    </div>

    {!-- was a fixed list of the origin and joining-policy menus; `menus/1` puts the public/private switch in the joining policy's place while the index answers a typed term. The dropdowns moved into `GroupFilterMenusLive`, which the feed views render in the tabs row --}
    <Bonfire.UI.Groups.GroupFilterMenusLive menus={menus(assigns)} form={@form} />
  </div>
</.form>
