<div class="flex flex-col">
  <div class="p-4 sm:p-6">
    {#case maybe_module(Bonfire.UI.Groups.Preview.GroupLive, @__context__)}
      {#match nil}
      {#match component}
        {#if @categories == []}
          <div
            id="group-discovery-empty"
            role="status"
            class="flex flex-col items-center justify-center px-6 py-10 text-center"
          >
            <div class="mb-4 grid size-14 place-items-center rounded-box bg-base-content/[0.04]">
              <Iconify.iconify
                icon={if @search_term != "",
                  do: "ph:magnifying-glass-duotone",
                  else: "ph:campfire-duotone"}
                class="size-7 text-subtle"
              />
            </div>

            {#if Bonfire.UI.Common.LoadMoreLive.end_cursor(@page_info)}
              <p class="text-base font-medium text-base-content">{l("No matching groups loaded yet")}</p>
              <p class="mt-1 max-w-sm text-sm text-muted">{l("Load more groups to keep looking, or change your filters.")}</p>
            {#elseif @search_term != ""}
              <p class="text-base font-medium text-base-content">
                {l("No groups match \"%{term}\"", term: @search_term)}
              </p>
              <p class="mt-1 max-w-sm text-sm text-muted">
                {l("Try another word, or clear your filters to browse all groups.")}
              </p>
            {#elseif @join_filter != "all"}
              <p class="text-base font-medium text-base-content">{l("No groups match this joining policy")}</p>
              <p class="mt-1 max-w-sm text-sm text-muted">{l("Choose another joining policy, or clear your filters.")}</p>
            {#elseif @origin == "local"}
              <p class="text-base font-medium text-base-content">{l("No groups on this instance yet")}</p>
              <p class="mt-1 max-w-sm text-sm text-muted">{l("Start one, or look at groups on other instances.")}</p>
            {#elseif @origin == "remote"}
              <p class="text-base font-medium text-base-content">{l("No groups from other instances yet")}</p>
              <p class="mt-1 max-w-sm text-sm text-muted">{l("Groups from across the fediverse show up here once people on this instance discover them.")}</p>
            {#elseif @selected_tab == "joined"}
              <p class="text-base font-medium text-base-content">{l("You haven't joined any groups yet")}</p>
              <p class="mt-1 max-w-sm text-sm text-muted">{l("Choose All groups to find a group to join.")}</p>
            {#else}
              <p class="text-base font-medium text-base-content">{l("No groups here yet")}</p>
              <p class="mt-1 max-w-sm text-sm text-muted">
                {l("Groups are spaces for people to gather around something: a topic, a practice, a place.")}
              </p>
            {/if}
            <LinkLive
              :if={@search_term != "" or @join_filter != "all" or @origin != "all"}
              opts={[id: "group-discovery-clear-filters"]}
              to={"/groups?tab=#{@selected_tab}"}
              class="btn btn-sm btn-ghost mt-3"
            >{l("Clear filters")}</LinkLive>
          </div>
        {#else}
          <div
            id={if @selected_tab == "joined", do: "group-joined-grid", else: "group-discovery-grid"}
            class="grid grid-cols-[repeat(auto-fill,minmax(min(100%,16rem),1fr))] items-stretch gap-3 sm:gap-4"
          >
            {#for {%{type: :group} = category, _children} <- @categories}
              <StatelessComponent
                module={component}
                object={category}
                preview={Map.get(@previews, id(category), %{})}
                permalink={path(category)}
                showing_within={:discovery}
              />
            {/for}
          </div>
        {/if}
    {/case}

    {#if Bonfire.UI.Common.LoadMoreLive.end_cursor(@page_info)}
      <p
        :if={@search_term != "" or @join_filter != "all" or (@origin != "all" and @selected_tab == "joined")}
        class="mt-4 text-center text-sm text-muted"
      >
        {l("Filters apply to the groups loaded so far. Load more to keep looking.")}
      </p>
      <Bonfire.UI.Common.LoadMoreLive
        :if={@page_info}
        live_handler="Bonfire.UI.Groups.ExploreLive"
        page_info={@page_info}
        context={if @selected_tab == "joined", do: "joined", else: nil}
        hide_if_no_more
      />
    {/if}
  </div>
</div>
