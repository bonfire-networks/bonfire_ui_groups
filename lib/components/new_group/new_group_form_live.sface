<div class="contents">
  <Form
    for={%{}}
    as={:category}
    id="new_group_form"
    class="flex flex-col w-full gap-4"
    submit="Bonfire.UI.Groups:new"
    action="Bonfire.UI.Groups:new"
    opts={autocomplete: "off"}
  >
    {!-- Intent framing --}
    <p class="-mt-3 text-sm leading-relaxed text-muted">
      {l("A space for people to gather around something: a topic, a practice, a place.")}
    </p>

    {!-- Name + description --}
    <section class="flex flex-col gap-2">
      <div class="form-control">
        <label for="new_group_name" class="text-sm font-medium text-muted mb-1">
          {l("Group name")} <span class="text-error" aria-hidden="true">*</span>
        </label>
        <input
          id="new_group_name"
          name="name"
          type="text"
          required
          minlength="3"
          maxlength="120"
          phx-update="ignore"
          placeholder={l("e.g. Design team, Book club…")}
          onkeydown="if(event.key==='Enter'){event.preventDefault();const d=document.getElementById('new_group_summary');if(d && !d.closest('.hidden'))d.focus();}"
          class="peer w-full input input-bordered input-sm focus:input-primary invalid:input-error"
        />
        <span class="hidden peer-[:invalid:not(:placeholder-shown)]:block mt-1 text-xs text-error">
          {l("At least 3 characters.")}
        </span>
      </div>

      <div id="new_group_description" class="form-control">
        <textarea
          id="new_group_summary"
          name="summary"
          rows="2"
          maxlength="500"
          phx-update="ignore"
          class="w-full textarea textarea-bordered textarea-sm focus:textarea-primary"
          placeholder={l("What is this group about?")}
        />
      </div>
    </section>

    <Bonfire.UI.Groups.GroupBoundaryEditorLive
      id="new_group_boundary_editor"
      show_unavailable_toggles={@show_unavailable_toggles}
    />

    {!-- the sensitive mark, as in the group's settings (`Bonfire.UI.Groups.Settings.IdentityLive`). `category[…]`, which `Bonfire.Classify.LiveHandler.new/3` merges in, rather than a bare `sensitive`, which the composer's own field is named; the hidden `false` says so when the box is not ticked --}
    <div class="form-control">
      <input type="hidden" name="category[sensitive]" value="false">
      <label for="new_group_sensitive" class="flex items-center gap-3 cursor-pointer">
        <input
          id="new_group_sensitive"
          type="checkbox"
          name="category[sensitive]"
          value="true"
          aria-describedby="new_group_sensitive_help"
          class="checkbox checkbox-sm"
        />
        <span class="text-sm font-medium text-base-content">{l("Mark this group as sensitive")}</span>
      </label>
      <p id="new_group_sensitive_help" class="mt-1 text-xs text-muted leading-snug">
        {l(
          "People see a content warning before its posts, and its banner and icon are blurred. Lemmy, PieFed and Mbin treat it as NSFW: some of their instances hide or refuse it, so fewer people there will find it."
        )}
      </p>
    </div>

    {!-- Primary action --}
    <button type="submit" class="btn btn-primary w-full normal-case">
      <#Icon iconify="ph:check" class="size-4 mr-1" />{l("Create group")}
    </button>

    <input type="hidden" name="context_id" value={id(@parent)}>
  </Form>
</div>
