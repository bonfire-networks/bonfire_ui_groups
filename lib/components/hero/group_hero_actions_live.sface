<div
  data-id="profile_main_actions"
  data-role="group-hero-actions"
  class="flex items-center gap-2 sm:ml-auto"
>
  {!-- the main action: last on wide screens (as on X), first and widest on a phone --}
  {#if @variant == "visitor"}
    <div class="order-first flex-1 sm:order-last sm:flex-none [&_.btn]:w-full">
      <StatefulComponent
        id={"join_btn_#{id(@group)}"}
        module={maybe_component(Bonfire.Classify.Web.JoinButtonLive, @__context__)}
        object_id={id(@group)}
        object={@group}
        object_name={e(@group, :profile, :name, nil) || e(@group, :character, :username, l("Group"))}
        moderators={@moderators}
        membership={@membership_slug}
        my_membership={@my_membership}
        path={path(@group)}
        showing_within={:list}
        combined
        hide_follow
        class="btn btn-primary h-10 min-h-0 rounded-full px-5"
      />
    </div>
    {!-- not `follow_feed_<id>`: `JoinButtonLive` renders its own follow toggle with that id --}
    <StatefulComponent
      module={maybe_component(Bonfire.UI.Social.Graph.FollowButtonLive, @__context__)}
      id={"group_hero_follow_#{id(@group)}"}
      {...follow_button_props(@group, @variant)}
    />
  {#else}
    <span
      data-role="group-hero-status"
      class="order-first flex-1 sm:order-last sm:flex-none inline-flex h-10 items-center justify-center gap-1.5 rounded-full border border-divider px-4 text-sm font-semibold"
    >
      {if @moderator, do: l("Moderator"), else: l("Joined")}
    </span>
    <LinkLive
      :if={@moderator}
      to={Bonfire.Classify.Web.GroupNavigation.link("#{path(@group)}/settings", @group_return_to)}
      class={round_button_class()}
      label={l("Manage")}
    >
      <#Icon iconify="ph:gear-six" class="size-[18px]" />
      <span class="sr-only">{l("Manage")}</span>
    </LinkLive>
    <StatefulComponent
      :if={current_user_id(@__context__)}
      module={maybe_component(Bonfire.Notify.Web.BellButtonLive, @__context__)}
      id={"group_hero_bell_#{id(@group)}"}
      object={@group}
      button_class={round_button_class()}
      button_class_enabled={round_button_class(true)}
    />
  {/if}
  <div :if={current_user_id(@__context__)} data-role="group-hero-more">
    <Dropdown
      id={"group_hero_more_#{id(@group)}"}
      position="bottom-end"
      trigger_class={round_button_class()}
      panel_class="dropdown_actions text-base-content"
      label={l("More group actions")}
      expanded_touch_target
    >
      <:trigger>
        <#Icon iconify="ph:dots-three-outline-fill" class="size-[18px]" />
      </:trigger>
      <li :if={@variant == "member"} data-role="group-hero-follow">
        <StatefulComponent
          module={maybe_component(Bonfire.UI.Social.Graph.FollowButtonLive, @__context__)}
          id={"group_hero_follow_#{id(@group)}"}
          {...follow_button_props(@group, @variant)}
        />
      </li>
      <li :if={@permalink}>
        <a
          phx-hook="Copy"
          id={"group-hero-copy-url-#{id(@group)}"}
          href={@permalink}
          target="_top"
          class="flex items-center gap-3 text-sm"
        >
          <#Icon iconify="ph:copy-duotone" class="size-4 shrink-0 text-muted" />
          <span class="flex-1 truncate" data-role="label">{l("Copy link")}</span>
        </a>
      </li>
      <li>
        <StatelessComponent
          module={maybe_component(Bonfire.UI.Social.SubscribeFeedLive, @__context__)}
          feed_name={:user_activities}
          params={%{"username" => e(@group, :character, :username, nil)}}
          as_icon={false}
          parent_id={"group-hero-#{id(@group)}"}
        />
      </li>
      <li>
        {#if @pins.instance}
          {!-- instance-pinned groups stay in everyone's sidebar; personal pin/unpin can't remove them --}
          <div
            class="flex items-center gap-3 w-full text-sm text-muted"
            title={l("This group is pinned to everyone's sidebar by the admins")}
          >
            <#Icon iconify="ph:push-pin-duotone" class="size-4 shrink-0 text-muted" />
            <span class="flex-1 truncate">{l("Pinned by admins")}</span>
          </div>
        {#else}
          <StatelessComponent
            module={maybe_component(Bonfire.UI.Reactions.PinActionLive, @__context__)}
            object={@group}
            parent_id={"group-hero-sidebar-pin-#{id(@group)}"}
            scope={:sidebar}
            pinned?={@pins.sidebar}
          />
        {/if}
      </li>
      {!-- instance admins, whether or not they moderate this group --}
      <li :if={@pins.can_pin_instance}>
        <StatelessComponent
          module={maybe_component(Bonfire.UI.Groups.InstanceSidebarPinLive, @__context__)}
          group={@group}
          pinned?={@pins.instance}
          class="flex items-center gap-3 w-full"
        />
      </li>
      <li>
        <StatelessComponent
          module={maybe_component(Bonfire.UI.Moderation.FlagActionLive, @__context__)}
          object={@group}
          permalink={@permalink}
          is_remote={not is_nil(e(@group, :character, :peered, nil))}
          parent_id={"group-hero-#{id(@group)}"}
          object_type={e(@group, :profile, :name, l("this group"))}
          class="flex items-center p-4 justify-between"
        />
      </li>
      <li :if={@my_membership == true and not @moderator}>
        <button
          type="button"
          id={"group_hero_leave_#{id(@group)}"}
          :on-click="Bonfire.UI.Groups:open_leave_confirm"
          phx-value-id={id(@group)}
          phx-value-group-name={e(@group, :profile, :name, nil) || e(@group, :character, :username, nil)}
          phx-value-join-mode={@membership_slug && Bonfire.Classify.Categories.join_mode(@membership_slug)}
          aria-haspopup="dialog"
          aria-controls="modal_box"
          class="flex items-center gap-3 w-full text-sm text-error"
        >
          <#Icon iconify="ph:sign-out-duotone" class="size-4 shrink-0" />
          <span class="flex-1 truncate text-left">{l("Leave group")}</span>
        </button>
      </li>
    </Dropdown>
  </div>
</div>
