<section data-role="category_preview">
  <#slot {@header} />
  <div class="relative isolate mx-auto grid w-full max-w-2xl px-4 pb-8">
    <div
      class="pointer-events-none col-start-1 row-start-1 flex flex-col gap-3 select-none blur-sm"
      aria-hidden="true"
    >
      {#for _ <- 1..3}
        <div class="flex gap-3 rounded-box border border-divider bg-base-100 p-4">
          <div class="size-10 shrink-0 rounded-full bg-fill-strong" />
          <div class="flex flex-1 flex-col gap-2">
            <div class="h-3 w-1/3 rounded bg-fill-strong" />
            <div class="h-3 w-full rounded bg-fill" />
            <div class="h-3 w-4/5 rounded bg-fill" />
          </div>
        </div>
      {/for}
    </div>
    <div
      id="group_sensitive_notice"
      data-role="sensitive_group_notice"
      role="region"
      aria-labelledby="group_sensitive_notice_title"
      class="relative col-start-1 row-start-1 flex items-start justify-center px-4 pt-6"
    >
      <div class="flex w-full max-w-md flex-col items-center gap-4 rounded-box border border-divider bg-base-100 p-6 text-center shadow-xl">
        <div class="grid size-12 place-items-center rounded-full bg-warning/10" aria-hidden="true">
          <#Icon iconify="ph:warning-circle" class="size-6 text-warning" />
        </div>
        <h2 id="group_sensitive_notice_title" class="type-heading text-base-content">
          {l("Sensitive content")}
        </h2>
        <p class="text-sm text-muted">
          {l("May include content that some people would rather not see.")}
        </p>
        <button
          type="button"
          phx-click="Bonfire.UI.Groups:show_sensitive_group"
          class="btn btn-primary normal-case"
        >
          {l("Continue")}
        </button>
      </div>
    </div>
  </div>
</section>
