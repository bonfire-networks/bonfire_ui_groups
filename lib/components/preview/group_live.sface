{#if @showing_within in [:discovery, :joined]}
  {!-- the whole row opens the group (the name link stretches over it), so the few things inside that link elsewhere sit above that overlay with `relative z-10` --}
  <article
    id={"group-preview-#{id(@object)}"}
    class="relative grid min-w-0 grid-cols-[2.75rem_minmax(0,1fr)] items-start sm:grid-cols-[2.75rem_minmax(0,1fr)_auto] gap-x-4 rounded-box px-2 py-4 transition-colors hover:bg-fill sm:px-4 has-[a:focus-visible]:outline has-[a:focus-visible]:outline-2 has-[a:focus-visible]:outline-offset-2"
  >
    {#case Media.avatar_url(@object)}
      {#match "/images/avatar.png"}
        <Bonfire.UI.Common.NavTileLive
          object={@object}
          name={name(@object)}
          class="!size-11 !rounded-box !text-base"
        />
      {#match url}
        <img
          src={url}
          alt=""
          width="44"
          height="44"
          class="size-11 rounded-box bg-fill object-cover"
          loading="lazy"
          aria-hidden="true"
        />
    {/case}

    <div class="flex min-w-0 flex-col gap-0.5">
      <LinkLive
        opts={[id: "group-preview-link-#{id(@object)}", title: handle(@object)]}
        to={@permalink}
        class="block truncate text-[0.9375rem] font-semibold leading-5 text-base-content after:absolute after:inset-0 after:content-[''] focus-visible:outline-none"
      >{name(@object)}</LinkLive>

      <div class="flex min-w-0 items-center gap-1.5 text-[0.8125rem] leading-5 text-subtle">
        <span class="shrink-0 tabular-nums">{member_label(e(@preview, :member_count, 0), remote?(@object))}</span>
        <span
          :if={remote?(@object) and instance_host(@object)}
          data-role="group-card-origin"
          class="inline-flex min-w-0 shrink items-center gap-1.5"
          title={handle(@object)}
        >
          <span aria-hidden="true">·</span>
          <span class="truncate">{instance_host(@object)}</span>
        </span>
        {#for topic <- Enum.take(e(@preview, :topics, []), 2)}
          {!-- small to look at, 44px to tap: the padding grows the target, the negative margin keeps the line where it was --}
          <span :if={topic_name(topic)} class="inline-flex min-w-0 items-center gap-1.5">
            <span aria-hidden="true">·</span>
            <LinkLive
              to={path(topic)}
              class="relative z-10 -my-3 truncate py-3 hover:text-base-content hover:underline underline-offset-2 focus-visible:outline focus-visible:outline-2"
            >#{topic_name(topic)}</LinkLive>
          </span>
        {/for}
      </div>

      {!-- a div, not a p: the summary is rich text with its own paragraphs, and a p inside a p makes the browser close the outer one, so the clamp lost hold of it --}
      <div
        :if={e(@object, :profile, :summary, "") != ""}
        class="mt-1 line-clamp-2 max-w-prose text-sm leading-5 text-muted"
      >{rich(e(@object, :profile, :summary, ""))}</div>
    </div>

    {!-- the joining policy is the action: Join, Request to join, or nothing to press for an invite-only group. On a phone it sits under the text, so "Request to join" doesn't squeeze the name --}
    <div
      class="relative z-10 col-start-2 mt-3 justify-self-start sm:col-start-3 sm:row-start-1 sm:mt-0 sm:self-center"
      data-role="group-card-action"
    >
      {#if e(@preview, :membership, nil) == "invite_only" and not e(@preview, :joined?, false)}
        <span class="inline-flex h-8 items-center text-[0.8125rem] text-subtle">{l("Invite only")}</span>
      {#else}
        <StatefulComponent
          id={"join_btn_#{id(@object)}"}
          module={maybe_component(Bonfire.Classify.Web.JoinButtonLive, @__context__)}
          object_id={id(@object)}
          object={@object}
          object_name={name(@object)}
          membership={e(@preview, :membership, nil)}
          my_membership={if e(@preview, :joined?, false), do: true}
          path={@permalink}
          showing_within={:list}
          combined
          hide_follow
          class="btn btn-sm h-8 min-h-8 rounded-full border-0 bg-fill px-3.5 font-medium text-base-content shadow-none hover:bg-fill-strong"
          class_joined="btn btn-sm btn-ghost h-8 min-h-8 rounded-full px-3 font-medium text-subtle shadow-none max-sm:-ml-3"
        />
      {/if}
    </div>
  </article>
{#elseif @showing_within == :compact}
  {!-- compact card for carousels (eg. the guest homepage): no cover, nothing reserved for missing text --}
  <article
    id={"group-preview-#{id(@object)}"}
    data-role="group-card-compact"
    class="flex h-full min-w-0 flex-col gap-2 rounded-box bg-surface p-4"
  >
    <div class="flex min-w-0 items-center gap-3">
      <div
        class="relative grid size-10 shrink-0 place-items-center overflow-hidden rounded-box bg-base-200 text-base-content"
        aria-hidden="true"
      >
        {#case Media.avatar_url(@object)}
          {#match "/images/avatar.png"}
            <#Icon iconify="ph:users-three-duotone" class="size-5" />
          {#match url}
            <img
              src={url}
              alt=""
              width="40"
              height="40"
              class="absolute inset-0 h-full w-full object-cover"
              loading="lazy"
            />
        {/case}
      </div>
      <div class="min-w-0 flex-1">
        <LinkLive
          opts={[id: "group-preview-link-#{id(@object)}", title: handle(@object)]}
          to={@permalink}
          class="block truncate text-base font-bold leading-6 text-base-content underline-offset-2 hover:underline"
        >{name(@object)}</LinkLive>
        <div class="flex min-w-0 flex-wrap items-center gap-x-2 text-xs leading-5 text-muted">
          <span class="tabular-nums">{member_label(e(@preview, :member_count, 0), remote?(@object))}</span>
          {#case Bonfire.Boundaries.Presets.dimension_meta(:membership, e(@preview, :membership, nil))}
            {#match %{} = meta}
              <span class="inline-flex items-center gap-1" data-role="group-card-membership-policy">
                <Iconify.iconify icon={e(meta, :icon, "ph:users")} class="size-3.5" />
                {e(meta, :label, nil)}
              </span>
            {#match _}
          {/case}
        </div>
      </div>
    </div>
    <p
      :if={e(@object, :profile, :summary, "") not in [nil, ""]}
      class="line-clamp-2 text-sm leading-5 text-muted"
    >{Bonfire.Common.Text.markdown_to_text(e(@object, :profile, :summary, ""))}</p>
  </article>
{#elseif @showing_within == :feed}
  <div class="group block rounded-box overflow-hidden my-2 bg-base-200 hover:ring-2 hover:ring-primary/20 transition-all">
    {!-- Banner --}
    {#case Media.banner_url(@object, fallback: false)}
      {#match nil}
        <div class="h-40 w-full bg-primary group-hover:scale-[1.02] transition-transform duration-300" />
      {#match banner}
        <div
          class="h-40 w-full bg-center bg-cover bg-no-repeat bg-base-300 group-hover:scale-[1.02] transition-transform duration-300"
          style={"background-image: url('#{URI.encode(banner)}')"}
        />
    {/case}

    <div class="flex items-start gap-3 p-4">
      <LinkLive to={@permalink} class="group flex items-center gap-3">
        {!-- Avatar --}
        <div class="shrink-0 -mt-10 relative z-10">
          {#case Media.avatar_url(@object)}
            {#match "/images/avatar.png"}
              <div class="size-14 rounded-box bg-base-100 shadow-lg flex items-center justify-center">
                <#Icon iconify="ph:users-three-duotone" class="size-7 text-subtle" />
              </div>
            {#match url}
              <img src={url} class="size-14 rounded-box ring-2 ring-base-100 object-cover">
          {/case}
        </div>

        <div class="flex flex-col flex-1 min-w-0 gap-1">
          <div class="font-bold text-base text-base-content">
            {rich(name(@object))}
          </div>
          <div :if={e(@object, :profile, :summary, "") != ""} class="text-sm text-muted line-clamp-2">{Bonfire.Common.Text.markdown_to_text(e(@object, :profile, :summary, ""))}</div>
          {!-- Meta --}
          <div class="flex items-center gap-3 mt-1">
            <span class="flex items-center gap-1 text-xs text-subtle">
              <#Icon iconify="ph:users-duotone" class="size-4" />
              <!-- FIXME: n+1 -->
              {Categories.members_count(@object)} {l("members")}
            </span>
          </div>
        </div>
      </LinkLive>

      <div :if={current_user_id(@__context__)} class="shrink-0 self-start mt-1">
        <Bonfire.Classify.Web.CategoryActionsLive
          object={@object}
          activity_id={id(@activity)}
          object_boundary={@object_boundary}
          object_type={:group}
        />
      </div>
    </div>
  </div>
{#else}
  <article class="group">
    <div class="flex flex-col gap-card bg-base-100 p-card">
      <div class="flex items-start gap-card">
        {!-- Avatar --}
        <LinkLive to={@permalink} class="shrink-0 block" tabindex="-1" aria-hidden="true">
          {#case Media.avatar_url(@object)}
            {#match "/images/avatar.png"}
              <div class="size-28.75 rounded-box bg-primary flex items-center justify-center">
                <#Icon
                  iconify="ph:users-three-duotone"
                  class="size-12 text-primary-content group-hover:text-primary-content"
                />
              </div>
            {#match url}
              <img src={url} class="size-28.75 rounded-box object-cover">
          {/case}
        </LinkLive>

        {!-- Identity + summary + meta --}
        <div class="flex flex-col flex-1 min-w-0 gap-card">
          <div class="flex justify-between items-center">
            <LinkLive to={@permalink} class="type-title leading-tight text-base-content truncate">{name(@object)}</LinkLive>
            <div :if={current_user_id(@__context__)} class="shrink-0 self-start">
              <Bonfire.Classify.Web.CategoryActionsLive
                object={@object}
                showing_within={:list}
                activity_id={id(@activity)}
                object_boundary={@object_boundary}
                object_type={:group}
              />
            </div>
          </div>
          <p
            :if={e(@object, :profile, :summary, "") != ""}
            class="text-base text-base-content line-clamp-4"
          >{Bonfire.Common.Text.markdown_to_text(e(@object, :profile, :summary, ""))}</p>

          {!-- Meta line: governance chip + members count --}
        </div>
      </div>
      <div class="flex items-center flex-wrap gap-card text-base text-base-content">
        {!-- how many people are in a group is something only someone who may READ it gets to know, so the count is left out of the reduced view a `:see`-only visitor lands on. The governance chip below stays: that is the group's own stated policy, and it is what tells them whether joining is even possible. --}
        <div :if={@showing_within != :preview} class="inline-flex items-center gap-1">
          <!-- FIXME: n+1 -->
          <span class="type-heading">{Categories.members_count(@object)}</span> {l("members")}
        </div>
        <span :if={@showing_within != :preview} class="text-base-content/25" aria-hidden="true">·</span>
        {#case row_chip(@object)}
          {#match %{} = meta}
            <span
              title={e(meta, :description, e(meta, :label, ""))}
              class="inline-flex items-center gap-1.5 text-primary uppercase font-normal text-xs"
            >
              {e(meta, :label, "")}
            </span>
          {#match _}
        {/case}
      </div>
    </div>
  </article>
{/if}
