{#if @showing_within in [:discovery, :joined]}
  <article
    id={"group-preview-#{id(@object)}"}
    class="flex min-w-0 flex-col overflow-hidden rounded-xl border border-base-content/10 bg-base-100"
  >
    <div class="h-20 shrink-0 overflow-hidden bg-primary" aria-hidden="true">
      {#case Media.banner_url(@object, fallback: false)}
        {#match nil}
        {#match banner}
          <img src={banner} alt="" class="size-full object-cover" loading="lazy">
      {/case}
    </div>

    <div class="flex flex-1 flex-col gap-3 px-4 pb-4">
      <div class="flex min-w-0 items-start gap-3">
        <div
          class="relative -mt-3 grid shrink-0 place-items-center overflow-hidden rounded-xl border-2 border-base-100 bg-base-200 text-base-content"
          style="width: 3rem; height: 3rem; min-width: 3rem;"
          aria-hidden="true"
        >
          {#case Media.avatar_url(@object)}
            {#match "/images/avatar.png"}
              <#Icon iconify="ph:users-three-duotone" class="size-6" />
            {#match url}
              <img
                src={url}
                alt=""
                width="48"
                height="48"
                class="absolute inset-0 h-full w-full object-cover"
                loading="lazy"
              />
          {/case}
        </div>
        <div class="min-w-0 flex-1 pt-2">
          <LinkLive
            opts={[id: "group-preview-link-#{id(@object)}"]}
            to={@permalink}
            class="line-clamp-2 text-base font-semibold leading-snug text-base-content underline-offset-2 hover:underline focus-visible:rounded-sm focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2"
          >{name(@object)}</LinkLive>
          <p
            :if={handle(@object)}
            class="mt-0.5 truncate text-xs leading-5 text-muted"
            title={handle(@object)}
          >{handle(@object)}</p>
        </div>
      </div>

      <div
        :if={e(@object, :profile, :summary, "") != "" or e(@preview, :topics, []) != []}
        class="flex flex-col gap-1"
      >
        <p
          :if={e(@object, :profile, :summary, "") != ""}
          class="line-clamp-2 text-sm leading-5 text-base-content"
        >{e(@object, :profile, :summary, "")}</p>

        <div
          :if={e(@preview, :topics, []) != []}
          class="flex flex-wrap gap-x-3 gap-y-1"
          aria-label={l("Topics")}
        >
          {#for topic <- Enum.take(e(@preview, :topics, []), 2)}
            <LinkLive
              :if={topic_name(topic)}
              to={path(topic)}
              class="max-w-full truncate py-1 text-xs text-primary underline-offset-2 hover:underline focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2"
            >{topic_name(topic)}</LinkLive>
          {/for}
        </div>
      </div>

      <div class="mt-auto flex flex-wrap items-center gap-x-3 gap-y-2 border-t border-base-content/10 pt-3 text-xs leading-5 text-muted">
        <span class="tabular-nums">{member_label(e(@preview, :member_count, 0), remote?(@object))}</span>
        {#case scope_meta(@object, @preview)}
          {#match %{label: label, icon: icon}}
            <span class="inline-flex items-center gap-1">
              <Iconify.iconify icon={icon} class="size-3.5" />
              {label}
            </span>
        {/case}
        <span
          :if={current_user_id(@__context__)}
          id={"group-membership-#{id(@object)}"}
          class={
            "ml-auto inline-flex items-center gap-1",
            "font-medium text-base-content": e(@preview, :joined?, false)
          }
        >
          <#Icon :if={e(@preview, :joined?, false)} iconify="ph:check" class="size-3.5" />
          {if e(@preview, :joined?, false), do: l("Joined"), else: l("Not joined")}
        </span>
      </div>
    </div>
  </article>
{#elseif @showing_within == :feed}
  <div class="group block rounded-xl overflow-hidden my-2 bg-base-200 hover:ring-2 hover:ring-primary/20 transition-all">
    {!-- Banner --}
    {#case Media.banner_url(@object, fallback: false)}
      {#match nil}
        <div class="h-[160px] w-full bg-primary group-hover:scale-[1.02] transition-transform duration-300" />
      {#match banner}
        <div
          class="h-[160px] w-full bg-center bg-cover bg-no-repeat bg-base-300 group-hover:scale-[1.02] transition-transform duration-300"
          style={"background-image: url('#{URI.encode(banner)}')"}
        />
    {/case}

    <div class="flex items-start gap-3 p-4">
      <LinkLive to={@permalink} class="group flex items-center gap-3">
        {!-- Avatar --}
        <div class="shrink-0 -mt-10 relative z-10">
          {#case Media.avatar_url(@object)}
            {#match "/images/avatar.png"}
              <div class="w-14 h-14 rounded-xl bg-base-100 shadow-lg flex items-center justify-center">
                <#Icon iconify="ph:users-three-duotone" class="w-7 h-7 text-base-content/40" />
              </div>
            {#match url}
              <img src={url} class="w-14 h-14 rounded-xl ring-2 ring-base-100 object-cover">
          {/case}
        </div>

        <div class="flex flex-col flex-1 min-w-0 gap-1">
          <div class="font-bold text-base text-base-content">
            {rich(name(@object))}
          </div>
          <div :if={e(@object, :profile, :summary, "") != ""} class="text-sm text-muted line-clamp-2">{e(@object, :profile, :summary, "")}</div>
          {!-- Meta --}
          <div class="flex items-center gap-3 mt-1">
            <span class="flex items-center gap-1 text-xs text-base-content/40">
              <#Icon iconify="ph:users-duotone" class="size-4" />
              <!-- FIXME: n+1 -->
              {Categories.members_count(@object)} {l("members")}
            </span>
          </div>
        </div>
      </LinkLive>

      <div :if={current_user_id(@__context__)} class="shrink-0 self-start mt-1">
        <Bonfire.Classify.Web.CategoryActionsLive
          object={@object}
          activity_id={id(@activity)}
          object_boundary={@object_boundary}
          object_type={:group}
        />
      </div>
    </div>
  </div>
{#else}
  <article class="group">
    <div class="flex flex-col gap-card bg-base-100 p-card">
      <div class="flex items-start gap-card">
        {!-- Avatar --}
        <LinkLive to={@permalink} class="shrink-0 block" tabindex="-1" aria-hidden="true">
          {#case Media.avatar_url(@object)}
            {#match "/images/avatar.png"}
              <div class="w-[115px] h-[115px] rounded-xl bg-primary flex items-center justify-center">
                <#Icon
                  iconify="ph:users-three-duotone"
                  class="w-12 h-12 text-primary-content group-hover:text-primary-content"
                />
              </div>
            {#match url}
              <img src={url} class="w-[115px] h-[115px] rounded-xl object-cover">
          {/case}
        </LinkLive>

        {!-- Identity + summary + meta --}
        <div class="flex flex-col flex-1 min-w-0 gap-card">
          <div class="flex justify-between items-center">
            <LinkLive
              to={@permalink}
              class="font-medium text-display leading-tight text-base-content truncate"
            >{name(@object)}</LinkLive>
            <div :if={current_user_id(@__context__)} class="shrink-0 self-start">
              <Bonfire.Classify.Web.CategoryActionsLive
                object={@object}
                showing_within={:list}
                activity_id={id(@activity)}
                object_boundary={@object_boundary}
                object_type={:group}
              />
            </div>
          </div>
          <p
            :if={e(@object, :profile, :summary, "") != ""}
            class="text-body text-base-content line-clamp-4"
          >{e(@object, :profile, :summary, "")}</p>

          {!-- Meta line: governance chip + members count --}
        </div>
      </div>
      <div class="flex items-center flex-wrap gap-card text-body text-base-content">
        {!-- how many people are in a group is something only someone who may READ it gets to know, so the count is left out of the reduced view a `:see`-only visitor lands on. The governance chip below stays: that is the group's own stated policy, and it is what tells them whether joining is even possible. --}
        <div :if={@showing_within != :preview} class="inline-flex items-center gap-1">
          <!-- FIXME: n+1 -->
          <span class="font-medium text-[18px]">{Categories.members_count(@object)}</span> {l("members")}
        </div>
        <span :if={@showing_within != :preview} class="text-base-content/25" aria-hidden="true">·</span>
        {#case row_chip(@object)}
          {#match %{} = meta}
            <span
              title={e(meta, :description, e(meta, :label, ""))}
              class="inline-flex items-center gap-1.5 text-primary uppercase font-normal text-xs"
            >
              {e(meta, :label, "")}
            </span>
          {#match _}
        {/case}
      </div>
    </div>
  </article>
{/if}
