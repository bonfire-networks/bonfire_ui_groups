<ul
  role="tablist"
  class="flex justify-evenly border-t items-stretch gap-3 text-sm font-medium border-b border-divider"
>
  <li class="cursor-pointer hover:bg-fill flex-1 flex place-content-center">
    <div
      class="border-primary !text-base-content border-b-4 border-transparent inline-flex px-5 pb-3 pt-5 text-muted"
      role="tab"
    >
      {l("All")}
    </div>
  </li>

  <li class="cursor-pointer hover:bg-fill flex-1 flex place-content-center">
    <div class="border-b-4 border-transparent inline-flex px-5 pb-3 pt-5 text-muted" role="tab">{l("Moderation")}</div>
  </li>
</ul>