{#if !Bonfire.Classify.ensure_update_allowed(current_user(@__context__), @category)}
  <p class="p-4 text-sm text-muted">{l("You don't have permission to edit this group's settings.")}</p>
{#elseif @settings_component == Bonfire.UI.Groups.Settings.GeneralLive}
  <Bonfire.UI.Groups.Settings.GeneralLive {...assigns} />
{#else}
  <section id="group-settings-detail" class="bonfire-wrapper mx-auto w-full max-w-3xl px-4 pb-12 pt-5 sm:px-8">
    {#if @settings_component == Bonfire.UI.Groups.Settings.BoundariesLive}
      <Bonfire.UI.Groups.Settings.BoundariesLive id={"group_settings_boundaries_#{id(@category)}"} category={@category} boundary_preset={@boundary_preset} show_header={false} />
    {#else}
      <StatelessComponent module={@settings_component} {...assigns} />
    {/if}
  </section>
{/if}
