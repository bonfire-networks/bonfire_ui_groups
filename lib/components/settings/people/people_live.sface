<section
  id="group-settings-people"
  aria-labelledby="settings-people-heading"
  class="flex flex-col gap-3"
>
  <.form
    :if={@search_open?}
    for={@form}
    id="settings-people-search-form"
    phx-change="Bonfire.UI.Groups:search_settings_people"
    phx-submit="Bonfire.UI.Groups:search_settings_people"
    phx-target={@myself}
    class="flex items-center gap-2"
  >
    <label for="settings-people-search" class="sr-only">{l("Search members")}</label>
    <input
      id="settings-people-search"
      type="search"
      name={@form[:search].name}
      value={@form[:search].value}
      placeholder={l("Search members…")}
      phx-debounce="250"
      autocomplete="off"
      spellcheck="false"
      class="input w-full border-base-content/20 bg-base-200 text-base"
    />
    <button
      :if={@search != ""}
      id="settings-people-search-clear"
      type="button"
      :on-click="Bonfire.UI.Groups:clear_settings_people_search"
      phx-target={@myself}
      class="btn btn-ghost"
    >{l("Clear search")}</button>
  </.form>
  {!-- in the words the group's visibility already has (`Categories.roster_visibility_slug/1`) --}
  
  <div class="overflow-hidden rounded-box border border-divider bg-surface">
    <div class="flex min-h-11 items-center gap-3 px-4 py-3 font-medium sm:px-5">
      <span id="settings-people-heading" class="flex-1">{if is_integer(@member_count),
          do: lp("%{count} member", "%{count} members", @member_count, count: @member_count),
          else: l("Members")}</span>
      {!-- with only one page of members there's nothing to search for --}
      <button
        :if={is_nil(@member_count) or @member_count > 5 or @search_open?}
        id="group_settings_members_search_open"
        type="button"
        :on-click="Bonfire.UI.Groups:open_settings_people_search"
        phx-target={@myself}
        aria-expanded={@search_open?}
        aria-controls="settings-people-search-form"
        class="btn btn-ghost btn-circle btn-sm text-muted"
      >
        <#Icon iconify="ph:magnifying-glass" class="size-5" />
        <span class="sr-only">{l("Search members")}</span>
      </button>
      {!-- adding someone directly, for a moderator of the group who also moderates the instance (`Categories.can_add_members?/2`) --}
      <button
        :if={@can_add?}
        id="group_settings_people_add_open"
        type="button"
        :on-click="Bonfire.UI.Groups:toggle_settings_people_add"
        phx-target={@myself}
        aria-expanded={@add_open?}
        aria-controls="add_member_form"
        class="btn btn-ghost btn-circle btn-sm text-muted"
      >
        <#Icon iconify="ph:user-plus" class="size-5" />
        <span class="sr-only">{l("Add member")}</span>
      </button>
    </div>
    <div :if={@can_add? and @add_open?} class="px-4 pb-3 sm:px-5">
      <StatefulComponent
        module={Bonfire.UI.Groups.Settings.AddPersonLive}
        id={"add_member_#{id(@category)}"}
        category={@category}
        role={:member}
        parent={{__MODULE__, @id}}
      />
    </div>
    <p
    :if={@roster_visibility_slug}
    id="settings-people-audience"
    class="px-4 text-sm text-muted sm:px-5"
  >{l("Members visible to:")} {e(Bonfire.Boundaries.Presets.dimension_meta(:visibility, @roster_visibility_slug), :label, "")
    }</p>
    <ul>
      {#for person <- @people}
        <li
          id={"settings-person-#{id(person)}"}
          data-role="settings-person"
          class="flex items-center gap-3 px-4 py-3 sm:px-5"
        >
          <Bonfire.UI.Common.AvatarLive
            user_id={id(person)}
            src={Media.avatar_url(person)}
            wrapper_class="avatar shrink-0"
            class="size-10 overflow-hidden rounded-full"
            parent_id="settings-people"
          />
          <LinkLive to={path(person)} class="min-w-0 flex-1 hover:underline">
            <span class="block truncate font-medium">
              {if id(person) == current_user_id(@__context__),
                do: l("You"),
                else: e(person, :profile, :name, nil) || e(person, :character, :username, l("Member"))}
            </span>
            <span :if={e(person, :character, :username, nil)} class="block truncate text-sm text-muted">@{e(person, :character, :username, nil)}</span>
          </LinkLive>
          <span :if={Enum.any?(@moderators, &(id(&1) == id(person)))} class="shrink-0 text-sm text-muted">{l("Moderator")}</span>
          <Bonfire.UI.Groups.MemberActionsLive
            :if={@may_moderate? and id(person) != current_user_id(@__context__)}
            category={@category}
            person={person}
            parent_id={"settings-person-#{id(person)}"}
            event="Bonfire.UI.Groups:remove_settings_member"
            target={@myself}
          />
        </li>
      {/for}
    </ul>
    <p :if={@people == []} class="px-5 py-6 text-sm text-muted">{if @search != "", do: l("No members match your search."), else: l("No members to show.")}</p>
    <button
      :if={@cursor}
      id="group_settings_people_more"
      type="button"
      :on-click="Bonfire.UI.Groups:load_settings_people"
      phx-target={@myself}
      phx-disable-with={l("Loading…")}
      class="flex min-h-11 w-full items-center gap-3 px-4 py-3 text-left text-sm font-medium text-muted hover:bg-fill sm:px-5"
    >
      <span class="flex size-10 shrink-0 items-center justify-center">
        <#Icon iconify="ph:caret-down" class="size-4" />
      </span>
      {l("Load more")}
    </button>
  </div>
</section>
