<div
  id="group-settings-overview"
  class="bonfire-wrapper mx-auto flex w-full max-w-3xl flex-col gap-6 px-4 pb-12 pt-5 sm:px-8"
>
  {#if !Bonfire.Classify.ensure_update_allowed(current_user(@__context__), @category)}
    <div class="rounded-box border border-warning/30 bg-warning/5 p-4 text-sm text-muted">
      {l("You don't have permission to edit this group's settings.")}
    </div>
  {#else}
    <section
      aria-labelledby="settings-group-name"
      class="overflow-hidden rounded-box border border-divider bg-surface"
    >
      {#case Media.banner_url(@category, fallback: false)}
        {#match nil}
        {#match banner}
          <img src={banner} alt="" aria-hidden="true" class="h-20 w-full object-cover sm:h-24">
      {/case}
      <div class="flex items-center gap-4 px-4 py-4 sm:px-5">
        <img
          src={Media.avatar_url(@category)}
          alt=""
          width="56"
          height="56"
          class="size-14 shrink-0 rounded-full bg-base-200 object-cover"
        />
        <div class="min-w-0 flex-1">
          <h1 id="settings-group-name" class="break-words text-lg font-bold leading-snug">
            {e(@category, :profile, :name, nil) || e(@category, :character, :username, nil)}
          </h1>
          <p
            :if={e(@category, :profile, :summary, nil)}
            class="mt-0.5 line-clamp-2 break-words text-sm text-muted"
          >
            {e(@category, :profile, :summary, nil)}
          </p>
        </div>
        <Bonfire.UI.Common.OpenModalLive
          id="group_settings_identity"
          title_text={l("Edit group details")}
          open_btn_text={l("Edit")}
          open_btn_opts={[id: "group_settings_identity_open"]}
          open_modal_wrapper_class="shrink-0"
          open_btn_wrapper_class="btn btn-sm btn-outline border-divider"
          without_form
          no_actions
        >
          <Bonfire.UI.Groups.Settings.IdentityLive
            id="group_settings_identity_editor"
            category={@category}
          />
        </Bonfire.UI.Common.OpenModalLive>
      </div>
    </section>

    {!-- every row below comes from the settings `navigation` config (see `GeneralLive.entries/2`) --}
    {#for entry <- @people_entries}
      <StatefulComponent
        module={entry.component}
        id={"settings-people-#{id(@category)}"}
        category={@category}
        permalink={@permalink}
        member_count={@group_member_count}
        moderators={@moderators}
      />
    {/for}

    <section
      :if={@management_entries != []}
      aria-label={l("Group management")}
      class="overflow-hidden rounded-box border border-divider bg-surface"
    >
      {#for {entry, index} <- Enum.with_index(@management_entries)}
        <hr :if={index > 0} class="m-0 h-px border-0 bg-fill-strong">
        <Bonfire.UI.Groups.Settings.RowLive
          id={entry.id}
          to={entry.to}
          title={entry.title}
          description={entry[:description]}
          value={entry[:value]}
          icon={entry.icon}
        />
      {/for}
    </section>

    <section
      :if={@admin_entries != []}
      aria-labelledby="group-settings-instance-heading"
      class="flex flex-col gap-3"
    >
      <header class="flex items-center justify-between gap-3 px-1 text-sm text-muted">
        <h2 id="group-settings-instance-heading">{l("Instance administration")}</h2>
        <span>{l("Admins only")}</span>
      </header>
      <div class="overflow-hidden rounded-box border border-divider bg-surface">
        {#for {entry, index} <- Enum.with_index(@admin_entries)}
          <hr :if={index > 0} class="m-0 h-px border-0 bg-fill-strong">
          <Bonfire.UI.Groups.Settings.RowLive
            id={entry.id}
            to={entry.to}
            title={entry.title}
            description={entry[:description]}
            value={entry[:value]}
            icon={entry.icon}
          />
        {/for}
      </div>
    </section>

    <div
      :if={@danger_entries != []}
      class="overflow-hidden rounded-box border border-divider bg-surface"
    >
      {#for {entry, index} <- Enum.with_index(@danger_entries)}
        <hr :if={index > 0} class="m-0 h-px border-0 bg-fill-strong">
        <Bonfire.UI.Groups.Settings.RowLive
          id={entry.id}
          to={entry.to}
          title={entry.title}
          description={entry[:description]}
          value={entry[:value]}
          icon={entry.icon}
          danger
        />
      {/for}
    </div>
  {/if}
</div>
