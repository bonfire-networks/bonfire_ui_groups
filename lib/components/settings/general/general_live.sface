<div id="group-settings-overview" class="bonfire-wrapper mx-auto flex w-full max-w-3xl flex-col gap-6 px-4 pb-12 pt-5 sm:px-8">
  {#if !Bonfire.Classify.ensure_update_allowed(current_user(@__context__), @category)}
    <div class="rounded-lg border border-warning/30 bg-warning/5 p-4 text-sm text-base-content/80">
      {l("You don't have permission to edit this group's settings.")}
    </div>
  {#else}
    <section aria-labelledby="settings-group-name" class="flex flex-col items-center text-center">
      <div class="h-28 w-full overflow-hidden rounded-2xl bg-base-200 sm:h-36" aria-hidden="true">
        {#case Media.banner_url(@category, fallback: false)}
          {#match nil}
          {#match banner}
            <img src={banner} alt="" class="h-full w-full object-cover">
        {/case}
      </div>
      <img src={Media.avatar_url(@category)} alt="" width="80" height="80" class="relative -mt-9 size-20 rounded-full border-4 border-base-100 bg-base-200 object-cover">
      <h1 id="settings-group-name" class="mt-3 max-w-full break-words text-2xl font-semibold leading-tight">
        {e(@category, :profile, :name, nil) || e(@category, :character, :username, nil)}
      </h1>
      <p :if={e(@category, :profile, :summary, nil)} class="mt-2 max-w-lg break-words whitespace-pre-line text-sm text-muted">
        {e(@category, :profile, :summary, nil)}
      </p>
      <div class="mt-3">
        <Bonfire.UI.Common.OpenModalLive
          id="group_settings_identity"
          title_text={l("Edit group details")}
          open_btn_text={l("Edit group details")}
          open_btn_opts={[id: "group_settings_identity_open"]}
          open_btn_wrapper_class="min-h-11 rounded-lg px-4 py-2 text-center font-medium text-primary hover:bg-base-content/5 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2"
          without_form
          no_actions
        >
          <Bonfire.UI.Groups.Settings.IdentityLive id="group_settings_identity_editor" category={@category} />
        </Bonfire.UI.Common.OpenModalLive>
      </div>
    </section>

    <Bonfire.UI.Groups.Settings.PeopleLive
      id={"settings-people-#{id(@category)}"}
      category={@category}
      permalink={@permalink}
      member_count={@group_member_count}
      moderators={@moderators}
    />

    <section aria-label={l("Group management")} class="overflow-hidden rounded-2xl border border-base-content/10 bg-(--stream-surface)">
      <Bonfire.UI.Groups.Settings.RowLive
        id="group_settings_access_link"
        to={@permalink <> "/settings/boundaries"}
        title={l("Access & participation")}
        description={@membership_label}
        value={@visibility_label}
        icon="ph:shield-check"
      />
      <hr :if={module_enabled?(Bonfire.CommunityRules.Web.RulesBuilderLive, @__context__)} class="m-0 h-px border-0 bg-base-content/10" />
      <Bonfire.UI.Groups.Settings.RowLive
        :if={module_enabled?(Bonfire.CommunityRules.Web.RulesBuilderLive, @__context__)}
        id="group_settings_rules_link"
        to={@permalink <> "/settings/rules"}
        title={l("Community rules")}
        description={l("Guidelines members agree to when joining")}
        icon="ph:book-open"
      />
    </section>

    <section :if={Bonfire.Boundaries.can?(current_user(@__context__), :configure, :instance)} aria-labelledby="group-settings-instance-heading" class="flex flex-col gap-3">
      <header class="flex items-center justify-between gap-3 px-1 text-sm text-muted">
        <h2 id="group-settings-instance-heading">{l("Instance administration")}</h2>
        <span>{l("Admins only")}</span>
      </header>
      <div class="overflow-hidden rounded-2xl border border-base-content/10 bg-(--stream-surface)">
        <Bonfire.UI.Groups.Settings.RowLive
          id="group_settings_instance_link"
          to={@permalink <> "/settings/instance"}
          title={l("Instance settings")}
          description={l("Automatically add new users")}
          value={if Bonfire.Classify.Categories.auto_join_new_users?(@category), do: l("Auto-join on"), else: l("Auto-join off")}
          icon="ph:hard-drives"
        />
      </div>
    </section>

    <div class="overflow-hidden rounded-2xl border border-base-content/10 bg-(--stream-surface)">
      <Bonfire.UI.Groups.Settings.RowLive
        id="group_settings_archive_link"
        to={@permalink <> "/settings/archive"}
        title={l("Archive group")}
        description={l("You can restore the group later")}
        icon="ph:archive"
        danger
      />
    </div>
  {/if}
</div>
