<LinkLive to={@to} opts={[id: @id]} class={"flex min-h-11 w-full items-center gap-4 px-4 py-5 text-left hover:bg-base-content/5 focus-visible:outline focus-visible:outline-2 sm:px-5", "text-error": @danger}>
  <Iconify.iconify icon={@icon} class="size-5 shrink-0" aria-hidden="true" />
  <span class="min-w-0 flex-1">
    <span class="block font-medium">{@title}</span>
    <span :if={@description} class="mt-1 block text-sm leading-snug text-muted">{@description}</span>
  </span>
  <span :if={@value} class="max-w-[40%] text-right text-sm text-muted">{@value}</span>
  <#Icon iconify="ph:caret-right" class="size-4 shrink-0 text-muted" />
</LinkLive>
