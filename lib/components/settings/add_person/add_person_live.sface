<form id={form_id(@role)} phx-change="change" phx-target={@myself} class="w-full">
  <label for={"multi_select_#{__MODULE__}_text_input"} class="sr-only">{search_label(@role)}</label>
  <div class="relative">
    <Bonfire.UI.Common.MultiselectLive
      implementation={:live_select}
      mode={:single}
      form_input_name={field_name(@role)}
      field={:"add_#{@role}"}
      debounce={300}
      event_target={@myself}
      label={search_label(@role)}
      text_input_class="input w-full liveselect border-base-content/20 bg-base-200 text-base"
    />
    {!-- no `show_search`: its icon dispatches to the composer's form; styled like the card's "Search members…" field --}
  </div>
</form>
