<section data-role="category_preview">
  <#slot {@header} />
  <div class="relative isolate mx-auto grid w-full max-w-2xl px-4 pb-8">
    <div class="pointer-events-none col-start-1 row-start-1 flex flex-col gap-3 select-none blur-sm" aria-hidden="true">
      {#for _ <- 1..3}
        <div class="flex gap-3 rounded-xl border border-secondary bg-base-100 p-4">
          <div class="size-10 shrink-0 rounded-full bg-base-content/10" />
          <div class="flex flex-1 flex-col gap-2">
            <div class="h-3 w-1/3 rounded bg-base-content/10" />
            <div class="h-3 w-full rounded bg-base-content/5" />
            <div class="h-3 w-4/5 rounded bg-base-content/5" />
          </div>
        </div>
      {/for}
    </div>
    <div
      id="group_access_gate"
      role="region"
      aria-labelledby="group_access_gate_title"
      class="relative col-start-1 row-start-1 flex items-start justify-center px-4 pt-6"
    >
      <div class="flex w-full max-w-md flex-col items-center gap-4 rounded-xl border border-secondary bg-base-100 p-6 text-center shadow-xl">
        <div class="grid size-12 place-items-center rounded-full bg-primary/10" aria-hidden="true">
          <#Icon iconify="ph:lock-key-duotone" class="size-6 text-primary" />
        </div>
        <h2 id="group_access_gate_title" class="text-lg font-semibold text-base-content">
          {l("You don't have access to this group's contents.")}
        </h2>
        <a :if={is_nil(current_user(@__context__))} href={login_path(@permalink)} class="btn btn-primary min-h-11 normal-case">
          {l("Sign in")}
        </a>
      </div>
    </div>
  </div>
</section>
