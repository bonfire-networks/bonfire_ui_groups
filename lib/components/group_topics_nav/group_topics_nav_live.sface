<nav
  :if={show?(@topics, @can_create_topic)}
  data-id="group_topics"
  aria-label={topics_label(@group)}
  class={"flex min-w-0 items-center gap-1", "pr-4 lg:pr-6": @topics != []}
>
  {!-- with no topics the list holds only New topic, as a full-width bar: a lone chip at the edge of an empty row reads as unbalanced --}
  <ul
    id={"group-topics-#{id(@group)}"}
    data-role="group-topics-list"
    phx-hook="ScrollRow"
    class={list_class(@topics)}
  >
    <li :if={@topics != []} class="shrink-0">
      <LinkPatchLive
        to={Bonfire.Classify.Web.GroupNavigation.link(path(@group), @group_return_to)}
        opts={[id: "group-topic-all", "aria-current": if(is_nil(@selected_topic), do: "page")]}
        class={chip_class(is_nil(@selected_topic))}
      >{l("All")}</LinkPatchLive>
    </li>
    {#for topic <- @topics}
      <li class="shrink-0">
        {#if selected?(topic, @selected_topic)}
          {!-- the current chip has nowhere to navigate, so it opens the topic's actions instead; `fixed` lets the menu escape the row's horizontal scroll --}
          <Dropdown
            id={"group-topic-menu-#{id(topic)}"}
            position="bottom-start"
            strategy="fixed"
            trigger_class={chip_class(true)}
            trigger_opts={menu_trigger_opts(id(topic))}
            panel_class="dropdown_actions text-base-content"
            label={l("Actions for topic %{name}", name: topic_name(topic))}
          >
            <:trigger>
              <span class="opacity-70" aria-hidden="true">#</span>
              <span class="max-w-[14rem] truncate">{topic_name(topic)}</span>
              <#Icon iconify="carbon:chevron-down" class="size-3 shrink-0 opacity-70" />
            </:trigger>
            <li :if={not is_nil(e(@selected_topic, :character, nil)) and current_user_id(@__context__)}>
              <StatefulComponent
                module={maybe_component(Bonfire.UI.Social.Graph.FollowButtonLive, @__context__)}
                id={"group_topic_follow_#{id(topic)}"}
                object_id={uid(@selected_topic)}
                object={@selected_topic}
                path={path(@selected_topic)}
                title={l("Follow topic")}
                title_already={l("Unfollow topic")}
                verb={l("Follow topic")}
                verb_undo={l("Unfollow topic")}
                verb_already={l("Unfollow topic")}
                icon="ph:rss"
                icon_already="ph:rss"
                icon_class="size-4 shrink-0"
                container_class="flex w-full"
                class="flex items-center gap-3 w-full text-sm text-muted"
                class_already="flex items-center gap-3 w-full text-sm text-primary"
                with_bell={false}
              />
            </li>
            <li :if={current_user_id(@__context__)}>
              <StatefulComponent
                module={maybe_component(Bonfire.Notify.Web.BellButtonLive, @__context__)}
                id={"group_topic_bell_#{id(topic)}"}
                object={@selected_topic}
                lazy
                menu_item
              />
            </li>
            <li>
              <a
                phx-hook="Copy"
                id={"group-topic-copy-url-#{id(topic)}"}
                href={Bonfire.Classify.Web.GroupNavigation.topic_path(@group, topic)}
                target="_top"
                class="flex items-center gap-3 text-sm"
              >
                <#Icon iconify="ph:copy-duotone" class="size-4 shrink-0 text-muted" />
                <span class="flex-1 truncate" data-role="label">{l("Copy link")}</span>
              </a>
            </li>
            <li :if={@can_edit_topic}>
              <Bonfire.UI.Common.OpenModalLive
                id={"edit_topic_modal_#{uid(@selected_topic)}"}
                title_text={l("Edit topic")}
                no_actions
                open_btn_aria_label={l("Edit topic")}
                open_btn_wrapper_class="flex items-center gap-3 w-full text-sm"
              >
                <StatelessComponent
                  module={maybe_component(Bonfire.UI.Topics.Settings.GeneralLive, @__context__)}
                  category={@selected_topic}
                />
                <:open_btn>
                  <#Icon iconify="ph:gear-six-duotone" class="size-4 shrink-0 text-muted" />
                  <span class="flex-1 truncate text-left">{l("Topic settings")}</span>
                </:open_btn>
              </Bonfire.UI.Common.OpenModalLive>
            </li>
          </Dropdown>
        {#else}
          <LinkPatchLive
            to={Bonfire.Classify.Web.GroupNavigation.link(
              Bonfire.Classify.Web.GroupNavigation.topic_path(@group, topic),
              @group_return_to
            )}
            opts={[id: "group-topic-link-#{id(topic)}"]}
            class={chip_class(false)}
          >
            <span class="text-muted">#</span>
            <span class="max-w-[14rem] truncate">{topic_name(topic)}</span>
          </LinkPatchLive>
        {/if}
      </li>
    {/for}
    <li
      :if={@can_create_topic}
      data-role="group-topics-new"
      class={"shrink-0": @topics != [], "flex-1": @topics == []}
    >
      <StatelessComponent
        module={maybe_component(Bonfire.UI.Topics.NewTopicLive, @__context__)}
        id="new_topic_chips"
        parent={@group}
        label={l("New topic")}
        open_modal_wrapper_class="flex"
        open_btn_wrapper_class={new_topic_class(@topics == [])}
      >
        <:open_btn>
          <#Icon :if={@topics == []} iconify="ph:plus-circle" class="size-4 shrink-0" />
          <#Icon :if={@topics != []} iconify="ph:plus-bold" class="size-3.5 shrink-0" />
          <span>{l("New topic")}</span>
        </:open_btn>
      </StatelessComponent>
    </li>
  </ul>
</nav>
