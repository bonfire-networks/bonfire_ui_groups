<nav
  :if={show?(@topics, @can_create_topic)}
  data-id="group_topics"
  aria-label={topics_label(@group)}
  class={"relative flex min-w-0 items-center gap-1", "pr-4 lg:pr-6": @topics != []}
>
  {!-- with no topics the list holds only New topic, as a full-width bar: a lone chip at the edge of an empty row reads as unbalanced --}
  <ul
    id={"group-topics-#{id(@group)}"}
    data-role="group-topics-list"
    phx-hook="ScrollRow"
    class={list_class(@topics)}
  >
    <li :if={@topics != []} class="shrink-0">
      {!-- the plain path: this patches within `GroupLive`, which keeps the entry page in its state. Replaced: to={Bonfire.Classify.Web.GroupNavigation.link(path(@group), @group_return_to)} --}
      <LinkPatchLive
        to={path(@group)}
        opts={[id: "group-topic-all", "aria-current": if(is_nil(@selected_topic), do: "page")]}
        class={chip_class(is_nil(@selected_topic))}
      >{l("All")}</LinkPatchLive>
    </li>
    {#for topic <- @topics}
      <li class="shrink-0">
        {#if selected?(topic, @selected_topic)}
          {!-- the current chip has nowhere to navigate, so it opens the topic's actions instead; `fixed` lets the menu escape the row's horizontal scroll --}
          <Dropdown
            id={"group-topic-menu-#{id(topic)}"}
            position="bottom-start"
            strategy="fixed"
            trigger_class={chip_class(true)}
            trigger_opts={menu_trigger_opts(id(topic))}
            panel_class="dropdown_actions text-base-content"
            label={l("Actions for topic %{name}", name: topic_name(topic))}
          >
            <:trigger>
              <span class="opacity-70" aria-hidden="true">#</span>
              <span class="max-w-[14rem] truncate">{topic_name(topic)}</span>
              {!-- full strength and set off by a divider, so the chip reads as a menu: it is the only way to the topic's follow, bell and settings --}
              <span class="ml-0.5 border-l border-base-100/30 pl-1 flex items-center">
                <#Icon iconify="carbon:chevron-down" class="size-4 shrink-0" />
              </span>
            </:trigger>
            {!-- the items (follow, bell, Copy link, Get latest activities, Topic settings) are `Bonfire.UI.Topics.TopicActionsLive`, shared with a standalone topic's header; the bell's id there is what `menu_trigger_opts/1` loads on first open --}
            <StatelessComponent
              module={maybe_component(Bonfire.UI.Topics.TopicActionsLive, @__context__)}
              topic={@selected_topic}
              group={@group}
              can_edit_topic={@can_edit_topic}
            />
          </Dropdown>
        {#else}
          {!-- the plain path: this patches within `GroupLive`, which keeps the entry page in its state. Replaced: to={Bonfire.Classify.Web.GroupNavigation.link(Bonfire.Classify.Web.GroupNavigation.topic_path(@group, topic), @group_return_to)} --}
          <LinkPatchLive
            to={Bonfire.Classify.Web.GroupNavigation.topic_path(@group, topic)}
            opts={[id: "group-topic-link-#{id(topic)}"]}
            class={chip_class(false)}
          >
            <span class="text-muted">#</span>
            <span class="max-w-[14rem] truncate">{topic_name(topic)}</span>
          </LinkPatchLive>
        {/if}
      </li>
    {/for}
    <li
      :if={@can_create_topic}
      data-role="group-topics-new"
      class={"shrink-0": @topics != [], "flex-1": @topics == []}
    >
      <StatelessComponent
        module={maybe_component(Bonfire.UI.Topics.NewTopicLive, @__context__)}
        id="new_topic_chips"
        parent={@group}
        label={l("New topic")}
        open_modal_wrapper_class="flex"
        open_btn_wrapper_class={new_topic_class(@topics == [])}
      >
        <:open_btn>
          <#Icon :if={@topics == []} iconify="ph:plus-circle" class="size-4 shrink-0" />
          <#Icon :if={@topics != []} iconify="ph:plus-bold" class="size-3.5 shrink-0" />
          <span>{l("New topic")}</span>
        </:open_btn>
      </StatelessComponent>
    </li>
  </ul>
  {!-- edge fades as overlays, not a `mask-image` on the list: a mask clips every descendant, including the current chip's `fixed` menu --}
  <span
    :if={@topics != []}
    aria-hidden="true"
    class="pointer-events-none absolute inset-y-0 left-0 w-12 bg-linear-to-r from-base-100 opacity-0 transition-opacity peer-data-[fade-start]:opacity-100"
  />
  <span
    :if={@topics != []}
    aria-hidden="true"
    class="pointer-events-none absolute inset-y-0 right-4 w-12 bg-linear-to-l from-base-100 opacity-0 transition-opacity peer-data-[fade-end]:opacity-100 lg:right-6"
  />
</nav>
