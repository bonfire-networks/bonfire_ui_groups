<div data-id="groups_carousel_widget">
  <Bonfire.UI.Common.WidgetBlockLive
    :if={@groups != []}
    class={@wrapper_class}
    widget_title={@title}
    widget_subtitle={@subtitle}
    title_class={@title_class}
    heading_class="text-lg font-bold leading-snug tracking-[-0.01em] theme-light:text-lg theme-light:font-bold"
    subtitle_class="mt-1 text-sm text-muted theme-light:text-sm"
  >
    <:action>
      <Bonfire.UI.Common.CarouselArrowsLive track={"#{@id}-carousel"} count={length(@groups)} />
    </:action>
    <Bonfire.UI.Common.CarouselLive
      id={"#{@id}-carousel"}
      items={@groups}
      visible_items={2}
      class={@carousel_class}
    >
      {!-- the /groups directory card, so a group looks the same wherever a guest meets it --}
      <:card :let={item: {group, _topics}}>
        <StatelessComponent
          module={maybe_component(Bonfire.UI.Groups.Preview.GroupLive, @__context__)}
          object={group}
          preview={Map.get(@previews, id(group), %{})}
          permalink={path(group)}
          showing_within={:discovery}
        />
      </:card>
    </Bonfire.UI.Common.CarouselLive>
    <div class={@footer_class}>
      <LinkLive
        to="/groups"
        class="inline-flex min-h-11 items-center text-sm font-medium text-primary underline-offset-3 hover:underline"
      >{l("Browse all groups")}</LinkLive>
    </div>
  </Bonfire.UI.Common.WidgetBlockLive>
</div>
