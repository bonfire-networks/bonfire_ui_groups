<div data-id="groups_carousel_widget">
  <Bonfire.UI.Common.WidgetBlockLive
    :if={@groups != []}
    widget_title={@title}
    widget_subtitle={@subtitle}
    view_all_to="/groups"
    view_all_label={l("Browse all groups")}
  >
    <div class="widget-rows" data-role="widget-body" data-id="groups-widget-rows">
      {#for {group, _topics} <- @groups}
        <StatelessComponent
          module={maybe_component(Bonfire.UI.Groups.Preview.GroupLive, @__context__)}
          object={group}
          preview={Map.get(@previews, id(group), %{})}
          permalink={path(group)}
          showing_within={:widget_row}
        />
      {/for}
    </div>
  </Bonfire.UI.Common.WidgetBlockLive>
</div>
