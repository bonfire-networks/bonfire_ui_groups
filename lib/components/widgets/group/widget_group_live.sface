<Bonfire.UI.Common.WidgetBlockLive class="w-full flex-auto mx-auto border-y-hair border-divider">
  <div data-id="group_widget" class="flex flex-col divide-hair divide-divider text-sm">
    <section class="pb-3">
      <h3 class="mb-2 type-overline text-subtle">{l("About")}</h3>
      <ul class="flex flex-col gap-2">
        <li :if={@parent} data-role="group-widget-parent" class="flex items-center gap-2.5">
          <#Icon iconify="ph:arrow-bend-up-left" class="size-4 shrink-0 text-muted" />
          <span class="min-w-0 truncate">
            <span class="text-muted">{l("Part of")}</span>
            <LinkLive to={path(@parent)} class="font-medium hover:underline">{e(@parent, :profile, :name, nil)}</LinkLive>
          </span>
        </li>
        <li :if={@preset} data-role="group-widget-preset" class="flex items-start gap-2.5">
          <Iconify.iconify icon={e(@preset, :icon, nil)} class="mt-0.5 size-4 shrink-0 text-muted" />
          <span class="min-w-0">
            <span class="block font-medium">{e(@preset, :label, nil)}</span>
            <span class="mt-0.5 block text-muted leading-relaxed">{e(@preset, :description, nil)}</span>
          </span>
        </li>
        <li :if={@created} data-role="group-widget-created" class="flex items-center gap-2.5 text-muted">
          <#Icon iconify="ph:calendar-blank" class="size-4 shrink-0" />
          <span>{l("Created %{date}", date: @created)}</span>
        </li>
      </ul>
      {!-- a custom group has no sentence to summarise it, so its list starts open --}
      <details :if={@access_rows != []} open={!@preset} class="group/access mt-2.5">
        <summary class="inline-flex cursor-pointer list-none items-center gap-1 text-xs font-medium text-muted hover:text-base-content [&::-webkit-details-marker]:hidden">
          {if @preset, do: l("Who can"), else: l("Custom access")}
          <#Icon
            iconify="carbon:chevron-down"
            class="size-3 transition-transform group-open/access:rotate-180"
          />
        </summary>
        <dl
          data-role="group-access-list"
          class="mt-2 grid grid-cols-[auto_1fr] gap-x-3 gap-y-1.5 text-xs"
        >
          {#for {dimension, slug, label, meta} <- @access_rows}
            <div data-role={"group-widget-#{dimension}"} class="contents">
              <dt class="text-muted">{label}</dt>
              <dd title={e(meta, :description, nil)}>{Bonfire.UI.Groups.GroupHeroLive.hero_dimension_label(dimension, slug, meta)}</dd>
            </div>
          {/for}
        </dl>
      </details>
    </section>

    <section
      :if={maybe_apply(Bonfire.CommunityRules, :any_rules?, [@rules_sections], fallback_return: false)}
      data-role="group-widget-rules"
      class="py-3"
    >
      <h3 class="mb-2 type-overline text-subtle">{l("Rules")}</h3>
      <StatelessComponent
        module={maybe_component(Bonfire.CommunityRules.Web.RulesDisplayBodyLive, @__context__)}
        sections={@rules_sections}
        classes={%{list: "list-none flex flex-col gap-2.5"}}
        collapsible
      />
    </section>

    <section
      :if={@selected_tab != "members" and @moderators != []}
      data-role="group-sidebar-moderators"
      class="py-3"
    >
      <h3 class="mb-2 type-overline text-subtle">{l("Moderators")}</h3>
      <div class="flex flex-col">
        {#for user <- @moderators}
          <StatelessComponent
            module={maybe_component(Bonfire.UI.Me.ProfileItemLive)}
            wrapper_class="flex items-center justify-between gap-1 py-1"
            avatar_class="size-8 rounded-full"
            fallback_class="size-8 rounded-full"
            show_controls={[]}
            compact
            character={e(user, :character, nil)}
            profile={e(user, :profile, nil)}
            class="btn btn-circle btn-ghost btn-sm"
            parent_id={"group-widget-moderator-#{id(user)}"}
          />
        {/for}
      </div>
    </section>
  </div>
</Bonfire.UI.Common.WidgetBlockLive>
