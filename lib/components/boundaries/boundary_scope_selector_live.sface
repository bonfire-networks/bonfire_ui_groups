{!-- Two-level boundary selector: Row 1 = scope, Row 2 = access level for selected scope --}

<div id={"boundary_scope_#{@dimension}"} class="w-full flex flex-col gap-2">
  <div>
    <label class="block text-sm font-medium text-base-content">{@label}</label>
    {#if @description}
      <p class="mt-0.5 text-xs text-muted">{@description}</p>
    {/if}
  </div>

  {!-- Row 1: Scope, as a segmented control --}
  <div class="flex flex-wrap gap-0.5 p-0.5 rounded-box border border-divider bg-base-content/[0.03]">
    {#for {scope, scope_meta, is_selected} <- @scope_ordered}
      {#if e(scope_meta, :disabled, nil) || scope in @disabled_scopes}
        {#if @show_unavailable}
          <span
            title={e(scope_meta, :disabled, nil) || l("Coming soon")}
            class="flex-1 min-w-fit inline-flex items-center justify-center gap-1.5 h-8 px-3 whitespace-nowrap text-[13px] text-muted opacity-40 cursor-not-allowed"
          >
            <Iconify.iconify :if={e(scope_meta, :icon, nil)} icon={scope_meta[:icon]} class="size-3.5 shrink-0" />
            {e(scope_meta, :label, scope)}
          </span>
        {/if}
      {#else}
        <button
          type="button"
          phx-click="Bonfire.Classify:set_boundary_scope"
          phx-value-dim={@dimension}
          phx-value-scope={scope}
          phx-target={@target}
          aria-pressed={if is_selected, do: "true", else: "false"}
          title={e(scope_meta, :description, nil)}
          class={
            "flex-1 min-w-fit inline-flex items-center justify-center gap-1.5 h-8 px-3 whitespace-nowrap text-[13px] transition-colors duration-150 cursor-pointer",
            "bg-base-content/10 text-base-content font-medium shadow-sm": is_selected,
            "text-muted hover:text-base-content": !is_selected
          }
        >
          <Iconify.iconify :if={e(scope_meta, :icon, nil)} icon={scope_meta[:icon]} class="size-3.5 shrink-0" />
          {e(scope_meta, :label, scope)}
        </button>
      {/if}
    {/for}
  </div>

  {!-- Row 2: Access level, sitting right under its scope — shown when a scope is selected with >1 access variant --}
  {#if @selected_scope && length(@scope_slugs) > 1}
    <div class="mt-1 pl-3 border-l-2 border-divider">
      <div class="text-xs text-muted mb-2">
        {l("How visible, within %{scope}:",
          scope:
            e(
              Bonfire.Common.Config.get(:scopes, %{}, :bonfire_boundaries),
              @selected_scope,
              :label,
              @selected_scope
            )
        )}
      </div>
      <div class="flex flex-wrap gap-0.5 p-0.5 rounded-box border border-divider bg-base-content/[0.03]">
        {#for {slug, opt, role_meta, access_role, is_selected_access} <- @scope_slugs}
          {#if e(opt, :disabled, nil)}
            {#if @show_unavailable}
              <span
                title={e(opt, :disabled, nil) || l("Coming soon")}
                class="flex-1 min-w-fit inline-flex items-center justify-center gap-1.5 h-8 px-3 whitespace-nowrap text-[13px] text-muted opacity-40 cursor-not-allowed"
              >
                <Iconify.iconify :if={e(role_meta, :icon, nil)} icon={role_meta[:icon]} class="size-3.5 shrink-0" />
                {e(role_meta, :label, nil) || e(opt, :label, slug)}
              </span>
            {/if}
          {#else}
            <button
              type="button"
              phx-click="Bonfire.Classify:set_boundary_dimensions"
              phx-value-dim={@dimension}
              phx-value-slug={slug}
              phx-target={@target}
              aria-pressed={if is_selected_access, do: "true", else: "false"}
              title={e(role_meta, :description, nil) || e(opt, :description, nil)}
              class={
                "flex-1 min-w-fit inline-flex items-center justify-center gap-1.5 h-8 px-3 whitespace-nowrap text-[13px] transition-colors duration-150 cursor-pointer",
                "bg-base-content/10 text-base-content font-medium shadow-sm": is_selected_access,
                "text-muted hover:text-base-content": !is_selected_access
              }
            >
              <Iconify.iconify :if={e(role_meta, :icon, nil)} icon={role_meta[:icon]} class="size-3.5 shrink-0" />
              {e(role_meta, :label, nil) || e(opt, :label, slug)}
            </button>
          {/if}
        {/for}
      </div>
    </div>
  {/if}

  {#if @circles != []}
    <div class="mt-1 text-xs text-muted">{l("Or one of your circles")}</div>

    {!-- the first five, plus the selected one wherever it sits; the rest wait behind "N more" (a client-side reveal, so it survives re-renders) --}
    <div id={"boundary_scope_#{@dimension}_circles"} class="flex flex-wrap gap-1.5">
      {#for {circle, i} <- Enum.with_index(@circles)}
        <button
          type="button"
          phx-click="Bonfire.Classify:set_boundary_dimensions"
          phx-value-dim={@dimension}
          phx-value-slug={id(circle)}
          phx-target={@target}
          aria-pressed={if @selected == id(circle), do: "true", else: "false"}
          data-more={if i >= 5, do: "true"}
          title={l("Members of this circle")}
          class={
            "inline-flex items-center gap-1.5 h-8 px-3 rounded-full border text-[13px] transition-colors duration-150 cursor-pointer",
            "border-primary bg-primary/10 text-base-content": @selected == id(circle),
            "border-divider text-muted hover:bg-fill hover:text-base-content": @selected != id(circle),
            "!hidden": i >= 5 and @selected != id(circle)
          }
        >
          <#Icon
            iconify="ph:users-three"
            class={
              "size-3.5 shrink-0",
              "text-primary": @selected == id(circle)
            }
          />
          <span class="truncate max-w-[10rem]">{e(circle, :named, :name, e(circle, :name, l("Unnamed circle")))}</span>
        </button>
      {/for}

      {#if Enum.count(Enum.drop(@circles, 5), &(id(&1) != @selected)) > 0}
        <button
          type="button"
          phx-click={JS.remove_class("!hidden", to: "#boundary_scope_#{@dimension}_circles [data-more]") |> JS.hide()}
          class="inline-flex items-center gap-1 h-8 px-3 rounded-full border border-dashed border-divider text-[13px] text-muted hover:bg-fill hover:text-base-content transition-colors"
        >
          {l("%{count} more", count: Enum.count(Enum.drop(@circles, 5), &(id(&1) != @selected)))}
          <#Icon iconify="ph:caret-down" class="size-3" />
        </button>
      {/if}
    </div>
  {/if}

  <input type="hidden" name={@name} value={@selected}>
</div>
