<div>
  <Bonfire.UI.Common.SidebarSectionDividerLive />

  <div data-role="sidebar-groups" class="relative w-full min-w-0 overflow-hidden mt-3 px-0 lg:px-5.5">
    <div class="group/sidebar-summary relative min-h-7 py-1 pl-2 font-bold text-xs leading-4 text-muted flex">
      <LinkLive to="/groups" class="flex-1">{l("Groups")}</LinkLive>
      <div class="font-normal absolute right-0 inset-y-0 flex items-center">
        <Bonfire.UI.Groups.NewGroupLive
          id="sidebar_new_group"
          parent_id="sidebar"
          open_btn_wrapper_class=""
        >
          <:open_btn>
            <span class="[@media(hover:hover)]:opacity-0 group-hover/sidebar-summary:opacity-100 group-focus-within/sidebar-summary:opacity-100 btn btn-circle btn-outline btn-xs border-divider"><#Icon iconify="ph:plus" class="size-4 text-primary" /></span>
          </:open_btn>
        </Bonfire.UI.Groups.NewGroupLive>
      </div>
    </div>

    <ul class="menu p-0 w-full gap-0">
      <Bonfire.UI.Groups.SidebarGroupLive
        :for={{%{type: :group} = category, children} <- e(@categories, [])}
        category={category}
        children={children}
        parent_id={@id}
        preset_icon={e(@group_icons, id(category), nil)}
        instance_pinned={MapSet.member?(@instance_pinned_ids, id(category))}
        current_path={@current_path}
        group_return_to={@group_return_to}
      />
      {!-- <li>
        <LinkLive to="/groups" class="flex items-center !gap-2 !px-3 py-1.5 text-muted">
          <#Icon iconify="ph:compass" class="size-5 shrink-0 text-muted" />
          <span class="text-base font-normal">{l("All groups")}</span>
        </LinkLive>
      </li> --}
    </ul>
  </div>
</div>
