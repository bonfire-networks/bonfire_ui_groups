<div>
  <Bonfire.UI.Common.SidebarSectionDividerLive />

  <div
    data-role="sidebar-groups"
    class="relative w-full min-w-0 overflow-hidden mt-3 px-0 lg:px-5.5"
  >
    <div class="flex items-center justify-between min-h-8 pl-2 [@media(pointer:coarse)]:min-h-9">
      {!-- the label is the link to all groups; the chevron says so without a second icon competing with "+" --}
      <LinkLive
        to="/groups"
        label={l("All groups")}
        class="inline-flex items-center gap-0.5 -ml-1 px-1 min-h-8 rounded-selector text-sm font-bold text-muted hover:text-base-content focus-visible:outline focus-visible:outline-2 focus-visible:outline-primary [@media(pointer:coarse)]:min-h-9"
      >
        {l("Groups")}
        <#Icon iconify="carbon:chevron-right" class="size-3.5 ml-[2px] mt-[2px]" />
      </LinkLive>
      <Bonfire.UI.Groups.NewGroupLive
        id="sidebar_new_group"
        parent_id="sidebar"
        open_btn_wrapper_class="flex"
      >
        <:open_btn>
          <span class="flex size-8 items-center justify-center rounded-selector text-muted hover:bg-fill hover:text-base-content [@media(pointer:coarse)]:size-9">
            <#Icon iconify="ph:plus-bold" class="size-3.5" />
          </span>
        </:open_btn>
      </Bonfire.UI.Groups.NewGroupLive>
    </div>

    <ul class="menu p-0 w-full gap-0">
      <Bonfire.UI.Groups.SidebarGroupLive
        :for={{%{type: :group} = category, children} <- e(@categories, [])}
        category={category}
        children={children}
        parent_id={@id}
        preset_icon={e(@group_icons, id(category), nil)}
        instance_pinned={MapSet.member?(@instance_pinned_ids, id(category))}
        my_membership={Map.get(@my_memberships, id(category), false)}
        join_mode={Map.get(@join_modes, id(category))}
        current_path={@current_path}
        group_return_to={@group_return_to}
      />
      {!-- <li>
        <LinkLive to="/groups" class="flex items-center !gap-2 !px-3 py-1.5 text-muted">
          <#Icon iconify="ph:compass" class="size-5 shrink-0 text-muted" />
          <span class="text-base font-normal">{l("All groups")}</span>
        </LinkLive>
      </li> --}
    </ul>
  </div>
</div>
