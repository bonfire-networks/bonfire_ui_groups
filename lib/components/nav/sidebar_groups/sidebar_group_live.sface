<li
  id={@row_id}
  data-role="sidebar-group"
  data-unpinned={if @unpinned, do: "true"}
  class={"!block w-full min-w-0", "opacity-70": @unpinned}
>
  <div class="group/row relative !block !p-0 !rounded-none hover:!bg-transparent">
    {!-- shown for this session only (the user follows the group, hasn't pinned it): one click keeps it --}
    <button
      :if={@unpinned}
      type="button"
      data-role="sidebar_group_pin"
      phx-click="Bonfire.Social.Pins:pin"
      phx-value-direction="up"
      phx-value-id={@category.id}
      phx-value-scope="sidebar"
      title={l("Keep in sidebar")}
      aria-label={l("Keep %{group} in the sidebar", group: @group_name)}
      class={[
        "absolute top-0 z-10 flex size-9 [@media(pointer:coarse)]:size-10 items-center justify-center rounded-selector cursor-pointer hover:bg-fill-strong focus-visible:outline focus-visible:outline-2 focus-visible:outline-primary right-9 [@media(pointer:coarse)]:right-10",
        "[@media(hover:none)]:right-[4.5rem]": @topics != []
      ]}
    >
      <#Icon iconify="ph:push-pin" class="size-4 text-muted" />
    </button>
    {!-- a patch link with the plain path, on every page: the client sends it to the main view, which patches when it serves the route (inside `GroupLive`, keeping the entry page in its state) and otherwise answers with a live navigate, whose `_live_referer` is the page left. Replaced: <LinkLive to={Bonfire.Classify.Web.GroupNavigation.link(@group_path, @group_return_to)} ...> --}
    <LinkPatchLive
      to={@group_path}
      opts={[id: @row_id <> "-link", title: @group_name, "aria-current": if(@active?, do: "page", else: nil)]}
      class={[
        "nav-row h-9 [@media(pointer:coarse)]:h-10 !pr-10 hover:bg-fill focus-visible:outline focus-visible:outline-2 focus-visible:outline-primary",
        "[@media(pointer:coarse)]:!pr-12": @topics == [],
        "[@media(hover:none)]:!pr-20": @topics != [],
        "!pr-[4.5rem]": @unpinned,
        "bg-fill-strong": @active?
      ]}
    >
      {!-- with topics, the avatar makes way for the expand caret on hover/focus (the caret sits on top of it); screens that can't hover keep the avatar and show the caret next to the menu --}
      <span class={[
        "shrink-0 flex",
        "[@media(hover:hover)]:group-hover/row:opacity-0 [@media(hover:hover)]:group-has-[summary:focus-visible]/row:opacity-0":
          @topics != []
      ]}>
        {!-- a group marked sensitive gets its generated tile, not its icon: too small to blur and reveal.
             On touch, avatars grow to 32px circles so the picture carries the row and the label can stay regular weight --}
        {!-- the picked icon in its colour, else the initial: never the uploaded image (not loaded here). Was, before the icon:
        {#case if(Bonfire.Classify.Categories.sensitive?(@category), do: "/images/avatar.png", else: Media.avatar_url(@category))}
          {#match "/images/avatar.png"}
            <Bonfire.UI.Common.NavTileLive object={@category} name={@group_name} class="..." />
          {#match url}
            <div class="size-6 rounded-[5px] ... bg-cover" style={"background-image: url('#{URI.encode(url)}');"} aria-hidden="true" />
        {/case}
        --}
        <Bonfire.UI.Common.NavTileLive
          object={@category}
          name={@group_name}
          class="!size-6 !text-xs [@media(pointer:coarse)]:!size-8 [@media(pointer:coarse)]:!rounded-full [@media(pointer:coarse)]:!text-sm"
        />
      </span>
      <span class={["nav-label", Bonfire.UI.Common.LinkWidgetLive.active_label_class(@active?)]}>{@group_name}</span>
      <span
        :if={@preset_icon == "ph:lock-duotone"}
        data-role="group_private"
        class="-ml-1.5 shrink-0 flex items-center"
        title={l("Private group")}
      >
        <#Icon iconify="ph:lock-simple-fill" class="size-3 text-subtle" />
        <span class="sr-only">{l("Private group")}</span>
      </span>
      <span
        :if={@new_activity?}
        data-role="group-new-activity"
        class="ml-auto size-2 shrink-0 rounded-full bg-primary"
        title={l("New activity")}
      >
        <span class="sr-only">{l("New activity")}</span>
      </span>
    </LinkPatchLive>
    <details
      :if={@topics != []}
      id={@row_id <> "-topics"}
      open={@expanded?}
      class="group/sidebar-group !block"
    >
      <summary
        aria-label={l("Topics in %{group}", group: @group_name)}
        class="absolute left-0.5 top-0 z-10 flex !p-0 !min-h-0 !w-9 !h-9 [@media(pointer:coarse)]:!h-10 opacity-0 [@media(hover:none)]:left-auto [@media(hover:none)]:right-9 [@media(pointer:coarse)]:!right-10 [@media(hover:none)]:opacity-100 [@media(hover:hover)]:group-hover/row:opacity-100 focus-visible:opacity-100 items-center justify-center rounded-selector cursor-pointer list-none after:!content-none [&::-webkit-details-marker]:hidden group/caret !bg-transparent focus-visible:outline-none"
      >
        {!-- the summary stays a 36px hit area; only the visible chip matches the 24px avatar it replaces --}
        <span class="flex size-6 items-center justify-center rounded-[5px] bg-fill [@media(pointer:coarse)]:bg-transparent group-hover/caret:bg-fill-strong group-focus-visible/caret:outline group-focus-visible/caret:outline-2 group-focus-visible/caret:outline-primary">
          <#Icon
            iconify="carbon:chevron-down"
            class="size-3 text-muted transition-transform group-open/sidebar-group:rotate-180"
          />
        </span>
      </summary>
      <ul data-role="sidebar-topics" class="sidebar-child-list">
        <li
          :for={topic <- @topics}
          class="!block w-full min-w-0 !pl-7.5 [@media(pointer:coarse)]:!pl-9.5"
        >
          {!-- a patch link with the plain path, as the group's row above. Replaced: <LinkLive to={Bonfire.Classify.Web.GroupNavigation.link(topic.path, @group_return_to)} ...> --}
          <LinkPatchLive
            to={topic.path}
            opts={[
              id: @row_id <> "-topic-" <> topic.id,
              title: topic.name,
              "aria-current": if(topic.active?, do: "page", else: nil)
            ]}
            class={[
              "sidebar-child-link",
              "bg-fill-strong text-base-content": topic.active?,
              "text-muted": not topic.active?
            ]}
          >
            <span class="min-w-0 truncate">{topic.name}</span>
            {!-- the dot lines up with the group's, which sits left of the space the group row keeps for its ⋯ menu (the group link's right padding, less this link's own `px-3`). Was `class="ml-auto size-2 shrink-0 rounded-full bg-primary"`, at this row's edge --}
            <span
              :if={topic.new_activity?}
              data-role="topic-new-activity"
              class={[
                "ml-auto size-2 shrink-0 rounded-full bg-primary",
                "mr-7",
                "[@media(hover:none)]:mr-[4.25rem]": not @unpinned,
                "!mr-[3.75rem]": @unpinned
              ]}
              title={l("New activity")}
            >
              <span class="sr-only">{l("New activity")}</span>
            </span>
          </LinkPatchLive>
        </li>
      </ul>
    </details>
    {!-- the trigger hides until the row is hovered so a long list stays quiet, but stays shown on touch screens, which can't hover --}
    <Dropdown
      id={@row_id <> "-menu"}
      position="bottom-start"
      strategy="fixed"
      wrapper_class="!absolute right-0 top-0"
      trigger_class="flex !size-9 [@media(pointer:coarse)]:!size-10 items-center justify-center rounded-selector cursor-pointer hover:bg-fill-strong focus-visible:outline focus-visible:outline-2 focus-visible:outline-primary [@media(hover:hover)]:opacity-0 group-hover/row:opacity-100 focus-visible:opacity-100 aria-expanded:opacity-100"
      label={l("Options for %{group}", group: @group_name)}
      trigger_opts={@trigger_opts}
    >
      <:trigger>
        <#Icon
          iconify="ph:dots-three-vertical-bold"
          class="size-4 text-muted [@media(pointer:coarse)]:size-3.5 [@media(pointer:coarse)]:text-subtle"
        />
      </:trigger>
      <li>
        {!-- the shared Copy link item; the markup it replaced:
        <a
          phx-hook="Copy"
          id={@row_id <> "-copy-link"}
          data-role="sidebar_group_copy_link"
          href={Bonfire.Common.URIs.canonical_url(@category) ||
            Bonfire.Common.URIs.based_url(@group_path)}
          target="_top"
          class="flex items-center gap-3 w-full text-sm"
        >
          <#Icon iconify="ph:link" class="size-4 shrink-0" />
          <span class="flex-1 truncate" data-role="label">{l("Copy group link")}</span>
        </a>
        --}
        <Bonfire.UI.Common.CopyLinkLive
          id={@row_id <> "-copy-link"}
          role="sidebar_group_copy_link"
          label={l("Copy group link")}
          url={Bonfire.Common.URIs.canonical_url(@category) ||
            Bonfire.Common.URIs.based_url(@group_path)}
        />
      </li>
      {!-- asked only when this menu opens (its trigger pushes `load`), so the sidebar asks nothing per group up front --}
      <li :if={@show_bell?}>
        <StatefulComponent
          module={maybe_component(Bonfire.Notify.Web.BellButtonLive, @__context__)}
          id={@row_id <> "-bell"}
          object={@category}
          lazy
          menu_item
        />
      </li>
      {#case {@my_membership, @join_mode}}
        {#match {true, _}}
          <li>
            <button
              type="button"
              data-role="sidebar_group_leave"
              phx-click="Bonfire.UI.Groups:open_leave_confirm"
              phx-value-id={@category.id}
              phx-value-group-name={@group_name}
              phx-value-join-mode={@join_mode}
              aria-haspopup="dialog"
              aria-controls="modal_box"
              class="flex items-center gap-3 w-full text-sm text-error"
            >
              <#Icon iconify="ph:sign-out" class="size-4 shrink-0" />
              <span class="flex-1 truncate text-left">{l("Leave group")}</span>
            </button>
          </li>
        {#match {:requested, _}}
          <li>
            <div
              data-role="sidebar_group_pending"
              class="flex items-center gap-3 w-full text-sm text-muted pointer-events-none"
            >
              <#Icon iconify="ph:clock" class="size-4 shrink-0" />
              <span class="flex-1 truncate">{l("Join request pending")}</span>
            </div>
          </li>
        {#match {_, join_mode}}
          {!-- invite-only: moderators add members --}
          <li :if={join_mode in ["free", "request"]}>
            <button
              type="button"
              data-role="sidebar_group_join"
              phx-click="Bonfire.UI.Groups:join_group"
              phx-value-id={@category.id}
              class="flex items-center gap-3 w-full text-sm"
            >
              {!-- `#Icon` resolves its icon at compile time, so it takes a literal, not `join_mode` --}
              {#if join_mode == "request"}
                <#Icon iconify="ph:hand-waving" class="size-4 shrink-0" />
              {#else}
                <#Icon iconify="ph:sign-in" class="size-4 shrink-0" />
              {/if}
              <span class="flex-1 truncate text-left">{if join_mode == "request", do: l("Request to join"), else: l("Join group")}</span>
            </button>
          </li>
      {/case}
      {!-- an unpinned row has nothing to remove: it goes on its own at the next load --}
      <li :if={!@unpinned} role="separator" class="-mx-2 my-1 border-t border-divider" />
      <li :if={!@unpinned}>
        {#if @instance_pinned}
          {!-- instance-pinned groups stay in everyone's sidebar; a personal unpin can't remove them --}
          <div
            data-role="sidebar_group_admin_pinned"
            class="flex items-center gap-3 w-full text-sm text-muted pointer-events-none"
            title={l("This group is pinned to everyone's sidebar by the admins")}
          >
            <#Icon iconify="ph:push-pin-duotone" class="size-4 shrink-0" />
            <span class="flex-1 truncate">{l("Pinned by admins")}</span>
          </div>
        {#else}
          <button
            type="button"
            data-role="sidebar_group_unpin"
            phx-click="Bonfire.Social.Pins:pin"
            phx-value-direction="down"
            phx-value-id={@category.id}
            phx-value-scope="sidebar"
            class="flex items-center gap-3 w-full text-sm"
          >
            <#Icon iconify="ph:push-pin-slash" class="size-4 shrink-0" />
            <span class="flex-1 truncate text-left">{l("Remove from sidebar")}</span>
          </button>
        {/if}
      </li>
    </Dropdown>
  </div>
</li>
